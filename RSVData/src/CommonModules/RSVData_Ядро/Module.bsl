#Область ПрограммныйИнтерфейс

// Возвращает поддерживаемые категории объектов метаданных, доступные текущему пользователю на чтение.
//
// Возвращаемое значение:
//   Массив из Структура:
//     * Тип - Строка - категория в единственном числе (Справочник, Документ, РегистрНакопления, ...).
//     * Представление - Строка - человекочитаемое название категории.
//     * Количество - Число - сколько объектов категории доступно на чтение.
Функция ДоступныеТипы() Экспорт
	Результат = Новый Массив;
	Для Каждого Описание Из ПоддерживаемыеТипы() Цикл
		Количество = 0;
		Для Каждого ОбъектМетаданных Из Описание.Коллекция Цикл
			Если ЕстьПравоЧтения(ОбъектМетаданных) Тогда
				Количество = Количество + 1;
			КонецЕсли;
		КонецЦикла;
		Если Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Тип, Представление, Количество",
			Описание.Тип, Описание.Представление, Количество));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Возвращает объекты заданной категории, доступные текущему пользователю на чтение.
//
// Параметры:
//   Тип    - Строка - категория в единственном числе (Справочник, Документ, РегистрНакопления, ...).
//   Фильтр - Строка - необязательная подстрока: оставить объекты, у которых она есть в имени или
//            синониме (без учёта регистра). Пусто — все объекты категории.
//
// Возвращаемое значение:
//   Массив из Структура:
//     * Имя - Строка
//     * ПолноеИмя - Строка - FQN (Справочник.Номенклатура).
//     * Синоним - Строка
Функция ДоступныеОбъекты(Тип, Фильтр = "") Экспорт
	Описание = ОписаниеТипаПоИмени(Тип);
	Если Описание = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Неподдерживаемый тип объекта метаданных: %1", Тип);
	КонецЕсли;
	ФильтрВРег = ВРег(СокрЛП(Строка(Фильтр)));
	Результат = Новый Массив;
	Для Каждого ОбъектМетаданных Из Описание.Коллекция Цикл
		Если Не ЕстьПравоЧтения(ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		Синоним = ?(ПустаяСтрока(ОбъектМетаданных.Синоним), ОбъектМетаданных.Имя, ОбъектМетаданных.Синоним);
		Если ЗначениеЗаполнено(ФильтрВРег)
			И СтрНайти(ВРег(ОбъектМетаданных.Имя), ФильтрВРег) = 0
			И СтрНайти(ВРег(Синоним), ФильтрВРег) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Имя, ПолноеИмя, Синоним",
			ОбъектМетаданных.Имя, ОбъектМетаданных.ПолноеИмя(), Синоним));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Возвращает таблицы объекта, доступные для чтения данных: основная, табличные части
// и виртуальные таблицы регистров.
//
// Параметры:
//   ПолноеИмя - Строка - FQN объекта (Справочник.Номенклатура, РегистрНакопления.ТоварыНаСкладах).
//
// Возвращаемое значение:
//   Массив из Структура:
//     * Имя - Строка - имя таблицы для запроса.
//     * Вид - Строка - Основная / ТабличнаяЧасть / ВиртуальнаяТаблица.
//     * Представление - Строка.
Функция ДоступныеТаблицы(ПолноеИмя) Экспорт
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Объект метаданных не найден: %1", ПолноеИмя);
	КонецЕсли;
	Если Не ЕстьПравоЧтения(ОбъектМетаданных) Тогда
		ВызватьИсключение СтрШаблон("Нет права на чтение объекта: %1", ПолноеИмя);
	КонецЕсли;

	ТипОбъекта = ТипВФорматеПолногоИмени(ПолноеИмя);
	Результат = Новый Массив;
	Результат.Добавить(ОписаниеТаблицы(ПолноеИмя, "Основная", "Основная таблица"));

	Если ТипИмеетТабличныеЧасти(ТипОбъекта) Тогда
		Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
			Синоним = ?(ПустаяСтрока(ТабличнаяЧасть.Синоним), ТабличнаяЧасть.Имя, ТабличнаяЧасть.Синоним);
			Результат.Добавить(ОписаниеТаблицы(ПолноеИмя + "." + ТабличнаяЧасть.Имя, "ТабличнаяЧасть", Синоним));
		КонецЦикла;
	КонецЕсли;

	Для Каждого ИмяВиртуальнойТаблицы Из ВиртуальныеТаблицыРегистра(ТипОбъекта, ОбъектМетаданных) Цикл
		Результат.Добавить(ОписаниеТаблицы(ПолноеИмя + "." + ИмяВиртуальнойТаблицы, "ВиртуальнаяТаблица", ИмяВиртуальнойТаблицы));
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Возвращает состав полей таблицы объекта: реквизиты, измерения, ресурсы, стандартные реквизиты
// с типами и представлениями. Поддерживает основную таблицу, табличную часть и виртуальные таблицы
// регистров (Остатки/Обороты/ОстаткиИОбороты/СрезПоследних/СрезПервых) с вычисляемыми полями.
//
// Параметры:
//   ПолноеИмя - Строка - FQN таблицы: основной (Справочник.Номенклатура), табличной части
//               (Документ.РеализацияТоваровУслуг.Товары) либо виртуальной (РегистрНакопления.X.Остатки).
//
// Возвращаемое значение:
//   Массив из Структура:
//     * Имя - Строка
//     * Тип - Строка - типы поля через запятую (Число, СправочникСсылка.Номенклатура, ...).
//     * Вид - Строка - Реквизит / Измерение / Ресурс / СтандартныйРеквизит.
//     * Синоним - Строка
//     * Значения - Массив из Структура (Имя, Синоним) - только для полей-перечислений.
Функция СтруктураПолей(ПолноеИмя) Экспорт
	Части = СтрРазделить(ПолноеИмя, ".");
	Если Части.Количество() < 2 Тогда
		ВызватьИсключение СтрШаблон("Некорректное имя таблицы: %1", ПолноеИмя);
	КонецЕсли;

	ТипОбъекта = Части[0];
	ИмяОбъекта = Части[0] + "." + Части[1];
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ИмяОбъекта);
	Если ОбъектМетаданных = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Объект метаданных не найден: %1", ИмяОбъекта);
	КонецЕсли;
	Если Не ЕстьПравоЧтения(ОбъектМетаданных) Тогда
		ВызватьИсключение СтрШаблон("Нет права на чтение объекта: %1", ИмяОбъекта);
	КонецЕсли;

	Поля = Новый Массив;

	Если Части.Количество() >= 3 Тогда
		ИмяПодтаблицы = Части[2];
		Если ТипИмеетТабличныеЧасти(ТипОбъекта) Тогда
			ТабличнаяЧасть = НайтиТабличнуюЧасть(ОбъектМетаданных, ИмяПодтаблицы);
			Если ТабличнаяЧасть <> Неопределено Тогда
				ДобавитьПоляКоллекции(Поля, ТабличнаяЧасть.СтандартныеРеквизиты, "СтандартныйРеквизит");
				ДобавитьПоляКоллекции(Поля, ТабличнаяЧасть.Реквизиты, "Реквизит");
				Возврат Поля;
			КонецЕсли;
		КонецЕсли;
		Возврат ПоляВиртуальнойТаблицы(ОбъектМетаданных, ТипОбъекта, ИмяПодтаблицы);
	КонецЕсли;

	ДобавитьПоляОбъекта(Поля, ОбъектМетаданных, ТипОбъекта);
	Возврат Поля;
КонецФункции

// Читает данные таблицы объекта через систему компоновки данных по декларативному описанию.
//
// Параметры:
//   ОписаниеЗапроса - Структура, Соответствие - table, fields, filters, order, period, limit, offset.
//
// Возвращаемое значение:
//   Структура - Таблица, Колонки (Имя+Тип), Строки, КоличествоСтрок, Лимит, ЕстьЕщё.
Функция ВыполнитьЧтение(ОписаниеЗапроса) Экспорт
	ИмяТаблицы = Строка(ЗначениеПараметра(ОписаниеЗапроса, "table", ""));
	Если НЕ ЗначениеЗаполнено(ИмяТаблицы) Тогда
		ВызватьИсключение "Не указана таблица для чтения (параметр table).";
	КонецЕсли;

	Лимит = НормализованныйЛимит(ЗначениеПараметра(ОписаниеЗапроса, "limit", Неопределено));
	Смещение = Макс(0, ЦелоеЗначение(ЗначениеПараметра(ОписаниеЗапроса, "offset", Неопределено), 0));
	Период = ПериодИзЗначения(ЗначениеПараметра(ОписаниеЗапроса, "period", Неопределено));

	Источник = ВыражениеИсточника(ИмяТаблицы, Период);
	Схема = ПостроитьСхемуЧтения(Источник.Текст, Источник.ИспользуетсяПериод, Лимит + Смещение);

	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	Настройки = Компоновщик.Настройки;

	ДоступныеПоля = ДоступныеИменаПолей(Настройки);

	// Детальные записи: вывод в коллекцию значений берёт колонки из выбора группировки.
	ГруппировкаДеталей = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ГруппировкаДеталей.Использование = Истина;
	ПрименитьВыбор(ГруппировкаДеталей.Выбор, ЗначениеПараметра(ОписаниеЗапроса, "fields", Неопределено), ДоступныеПоля, ИмяТаблицы);

	ПрименитьОтборы(Настройки, ЗначениеПараметра(ОписаниеЗапроса, "filters", Неопределено), ДоступныеПоля, ИмяТаблицы);
	ПрименитьПорядок(Настройки, ЗначениеПараметра(ОписаниеЗапроса, "order", Неопределено), ДоступныеПоля, ИмяТаблицы);

	Если Источник.ИспользуетсяПериод Тогда
		ЗначениеПериода = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период"));
		Если ЗначениеПериода <> Неопределено Тогда
			ЗначениеПериода.Значение = Период;
			ЗначениеПериода.Использование = Истина;
		КонецЕсли;
	КонецЕсли;

	ТаблицаДанных = ВыполнитьКомпоновку(Схема, Настройки);
	ЕстьЕщё = ТаблицаДанных.Количество() >= Лимит + Смещение;
	Возврат СформироватьОтветТаблицы(ИмяТаблицы, ТаблицаДанных, Смещение, Лимит, ЕстьЕщё);
КонецФункции

// Выполняет произвольный запрос на языке запросов 1С и возвращает результат
// в том же формате, что и query (декларативное чтение).
//
// Параметры:
//   ТекстЗапроса - Строка - текст запроса на языке запросов 1С (только чтение данных).
//   Параметры    - Структура, Соответствие - значения параметров запроса (имя -> значение);
//                  даты передаются ISO-строкой ("ГГГГ-ММ-ДД" или "ГГГГ-ММ-ДДTчч:мм:сс"). Необязательный.
//   Лимит        - Число - максимум строк (по умолчанию 100, максимум 1000). Необязательный.
//
// Возвращаемое значение:
//   Структура - Таблица, Колонки (Имя+Тип), Строки, КоличествоСтрок, Лимит, ЕстьЕщё.
Функция ВыполнитьПроизвольныйЗапрос(ТекстЗапроса, Параметры = Неопределено, Лимит = Неопределено) Экспорт
	Текст = СокрЛП(Строка(?(ТекстЗапроса = Неопределено, "", ТекстЗапроса)));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		ВызватьИсключение "Не указан текст запроса (параметр query).";
	КонецЕсли;

	Если RSVData_Анонимизация.Включена() Тогда
		ОтказАнонимизации = RSVData_Анонимизация.ПроверитьЗапросНаПреобразованиеПДн(Текст);
		Если ОтказАнонимизации <> Неопределено Тогда
			ВызватьИсключение ОтказАнонимизации;
		КонецЕсли;
	КонецЕсли;

	НормЛимит = НормализованныйЛимит(Лимит);

	Попытка
		Запрос = Новый Запрос(Текст);
		УстановитьПараметрыЗапроса(Запрос, Параметры);
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		ВызватьИсключение СтрШаблон("Не удалось выполнить запрос: %1", ОписаниеОшибки());
	КонецПопытки;

	ТаблицаДанных = Новый ТаблицаЗначений;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		ТаблицаДанных.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;

	ЕстьЕщё = Ложь;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ТаблицаДанных.Количество() >= НормЛимит Тогда
			ЕстьЕщё = Истина;
			Прервать;
		КонецЕсли;
		НоваяСтрока = ТаблицаДанных.Добавить();
		Для Каждого Колонка Из ТаблицаДанных.Колонки Цикл
			НоваяСтрока[Колонка.Имя] = Выборка[Колонка.Имя];
		КонецЦикла;
	КонецЦикла;

	Возврат СформироватьОтветТаблицы("", ТаблицаДанных, 0, НормЛимит, ЕстьЕщё);
КонецФункции

// Возвращает полную структуру объекта метаданных за один вызов — для проектирования запросов
// на произвольной конфигурации: основная таблица, табличные части, виртуальные таблицы регистров.
//
// Параметры:
//   ПолноеИмя - Строка - FQN объекта (Справочник.Контрагенты, Документ.РеализацияТоваровУслуг,
//               РегистрНакопления.ТоварыНаСкладах). Именно объект (Тип.Имя), не таблица.
//
// Возвращаемое значение:
//   Структура:
//     * Объект, Синоним, Категория - Строка
//     * Таблицы - Массив из Структура (Имя=FQN для запроса, Вид, Представление, Поля)
//     * Владельцы - Массив (только для подчинённых справочников)
Функция СтруктураОбъекта(ПолноеИмя) Экспорт
	Имя = СокрЛП(Строка(?(ПолноеИмя = Неопределено, "", ПолноеИмя)));
	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		ВызватьИсключение "Не указан объект (параметр object).";
	КонецЕсли;
	Части = СтрРазделить(Имя, ".");
	Если Части.Количество() <> 2 Тогда
		ВызватьИсключение СтрШаблон(
			"Укажите объект в формате Тип.Имя (например Справочник.Контрагенты), а не таблицу: %1", Имя);
	КонецЕсли;

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Имя);
	Если ОбъектМетаданных = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Объект метаданных не найден: %1", Имя);
	КонецЕсли;
	Если НЕ ЕстьПравоЧтения(ОбъектМетаданных) Тогда
		ВызватьИсключение СтрШаблон("Нет права на чтение объекта: %1", Имя);
	КонецЕсли;

	ТипОбъекта = Части[0];

	Таблицы = Новый Массив;
	Для Каждого Таблица Из ДоступныеТаблицы(Имя) Цикл
		ОписаниеТаб = Новый Структура;
		ОписаниеТаб.Вставить("Имя", Таблица.Имя);
		ОписаниеТаб.Вставить("Вид", Таблица.Вид);
		ОписаниеТаб.Вставить("Представление", Таблица.Представление);
		ОписаниеТаб.Вставить("Поля", СтруктураПолей(Таблица.Имя));
		Таблицы.Добавить(ОписаниеТаб);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Объект", Имя);
	Результат.Вставить("Синоним", ?(ПустаяСтрока(ОбъектМетаданных.Синоним), ОбъектМетаданных.Имя, ОбъектМетаданных.Синоним));
	Результат.Вставить("Категория", ТипОбъекта);
	Результат.Вставить("Таблицы", Таблицы);

	Если ТипОбъекта = "Справочник" И ОбъектМетаданных.Владельцы.Количество() > 0 Тогда
		Владельцы = Новый Массив;
		Для Каждого Владелец Из ОбъектМетаданных.Владельцы Цикл
			Владельцы.Добавить(Владелец.ПолноеИмя());
		КонецЦикла;
		Результат.Вставить("Владельцы", Владельцы);
	КонецЕсли;

	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПоддерживаемыеТипы()
	Типы = Новый Массив;
	ДобавитьОписаниеТипа(Типы, "Справочник", "Справочники", Метаданные.Справочники);
	ДобавитьОписаниеТипа(Типы, "Документ", "Документы", Метаданные.Документы);
	ДобавитьОписаниеТипа(Типы, "РегистрСведений", "Регистры сведений", Метаданные.РегистрыСведений);
	ДобавитьОписаниеТипа(Типы, "РегистрНакопления", "Регистры накопления", Метаданные.РегистрыНакопления);
	ДобавитьОписаниеТипа(Типы, "РегистрБухгалтерии", "Регистры бухгалтерии", Метаданные.РегистрыБухгалтерии);
	ДобавитьОписаниеТипа(Типы, "ПланСчетов", "Планы счетов", Метаданные.ПланыСчетов);
	ДобавитьОписаниеТипа(Типы, "ПланВидовХарактеристик", "Планы видов характеристик", Метаданные.ПланыВидовХарактеристик);
	ДобавитьОписаниеТипа(Типы, "Перечисление", "Перечисления", Метаданные.Перечисления);
	Возврат Типы;
КонецФункции

Процедура ДобавитьОписаниеТипа(Типы, Тип, Представление, Коллекция)
	Типы.Добавить(Новый Структура("Тип, Представление, Коллекция", Тип, Представление, Коллекция));
КонецПроцедуры

Функция ОписаниеТипаПоИмени(Тип)
	Для Каждого Описание Из ПоддерживаемыеТипы() Цикл
		Если Описание.Тип = Тип Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ЕстьПравоЧтения(ОбъектМетаданных)
	Попытка
		Возврат ПравоДоступа("Чтение", ОбъектМетаданных);
	Исключение
		// У некоторых объектов (например перечислений) право «Чтение» не определяется — считаем доступным.
		Возврат Истина;
	КонецПопытки;
КонецФункции

Функция ТипВФорматеПолногоИмени(ПолноеИмя)
	Позиция = СтрНайти(ПолноеИмя, ".");
	Если Позиция = 0 Тогда
		Возврат ПолноеИмя;
	КонецЕсли;
	Возврат Лев(ПолноеИмя, Позиция - 1);
КонецФункции

Функция ТипИмеетТабличныеЧасти(ТипОбъекта)
	ТипыСТабличнымиЧастями = "Справочник,Документ,ПланВидовХарактеристик,ПланСчетов,ПланВидовРасчета,БизнесПроцесс,Задача,ПланОбмена";
	Возврат СтрНайти("," + ТипыСТабличнымиЧастями + ",", "," + ТипОбъекта + ",") > 0;
КонецФункции

Функция ВиртуальныеТаблицыРегистра(ТипОбъекта, ОбъектМетаданных)
	Имена = Новый Массив;
	Если ТипОбъекта = "РегистрНакопления" Тогда
		Если ОбъектМетаданных.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
			Имена.Добавить("Остатки");
			Имена.Добавить("Обороты");
			Имена.Добавить("ОстаткиИОбороты");
		Иначе
			Имена.Добавить("Обороты");
		КонецЕсли;
	ИначеЕсли ТипОбъекта = "РегистрСведений" Тогда
		Если ОбъектМетаданных.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
			Имена.Добавить("СрезПоследних");
			Имена.Добавить("СрезПервых");
		КонецЕсли;
	ИначеЕсли ТипОбъекта = "РегистрБухгалтерии" Тогда
		Имена.Добавить("Остатки");
		Имена.Добавить("Обороты");
		Имена.Добавить("ОстаткиИОбороты");
	КонецЕсли;
	Возврат Имена;
КонецФункции

Функция ОписаниеТаблицы(Имя, Вид, Представление)
	Возврат Новый Структура("Имя, Вид, Представление", Имя, Вид, Представление);
КонецФункции

Процедура ДобавитьПоляОбъекта(Поля, ОбъектМетаданных, ТипОбъекта)
	ЭтоРегистр = (ТипОбъекта = "РегистрСведений" ИЛИ ТипОбъекта = "РегистрНакопления" ИЛИ ТипОбъекта = "РегистрБухгалтерии");
	ЭтоСсылочный = (ТипОбъекта = "Справочник" ИЛИ ТипОбъекта = "Документ"
		ИЛИ ТипОбъекта = "ПланВидовХарактеристик" ИЛИ ТипОбъекта = "ПланСчетов");

	Если ЭтоРегистр ИЛИ ЭтоСсылочный Тогда
		ДобавитьПоляКоллекции(Поля, ОбъектМетаданных.СтандартныеРеквизиты, "СтандартныйРеквизит");
	КонецЕсли;
	Если ЭтоРегистр Тогда
		ДобавитьПоляКоллекции(Поля, ОбъектМетаданных.Измерения, "Измерение");
		ДобавитьПоляКоллекции(Поля, ОбъектМетаданных.Ресурсы, "Ресурс");
	КонецЕсли;
	Если ЭтоРегистр ИЛИ ЭтоСсылочный Тогда
		ДобавитьПоляКоллекции(Поля, ОбъектМетаданных.Реквизиты, "Реквизит");
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьПоляКоллекции(Поля, Коллекция, ВидПоля)
	Для Каждого Поле Из Коллекция Цикл
		Синоним = ?(ПустаяСтрока(Поле.Синоним), Поле.Имя, Поле.Синоним);
		ОписаниеПоля = Новый Структура("Имя, Тип, Вид, Синоним",
			Поле.Имя, ПредставлениеТипа(Поле.Тип), ВидПоля, Синоним);
		Значения = ЗначенияПеречисления(Поле.Тип);
		Если Значения.Количество() > 0 Тогда
			ОписаниеПоля.Вставить("Значения", Значения);
		КонецЕсли;
		Поля.Добавить(ОписаниеПоля);
	КонецЦикла;
КонецПроцедуры

Функция ПредставлениеТипа(ОписаниеТиповПоля)
	Имена = Новый Массив;
	Для Каждого ТипЗначения Из ОписаниеТиповПоля.Типы() Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
		Если ОбъектМетаданных <> Неопределено Тогда
			Имена.Добавить(ОбъектМетаданных.ПолноеИмя());
		Иначе
			Имена.Добавить(Строка(ТипЗначения));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Имена, ", ");
КонецФункции

Функция НайтиТабличнуюЧасть(ОбъектМетаданных, ИмяТабличнойЧасти)
	Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
		Если ТабличнаяЧасть.Имя = ИмяТабличнойЧасти Тогда
			Возврат ТабличнаяЧасть;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// --- Чтение данных через систему компоновки данных ---

Функция ЗначениеПараметра(Описание, Ключ, ПоУмолчанию)
	Если ТипЗнч(Описание) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Описание.Свойство(Ключ, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Описание) = Тип("Соответствие") Тогда
		Значение = Описание.Получить(Ключ);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Функция ЦелоеЗначение(Значение, ПоУмолчанию)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Цел(Значение);
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Функция НормализованныйЛимит(Значение)
	Лимит = ЦелоеЗначение(Значение, 0);
	Если Лимит <= 0 Тогда
		Возврат 100;
	КонецЕсли;
	Если Лимит > 1000 Тогда
		Возврат 1000;
	КонецЕсли;
	Возврат Лимит;
КонецФункции

Функция ПериодИзЗначения(Значение)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	Стр = СокрЛП(Строка(Значение));
	Если НЕ ЗначениеЗаполнено(Стр) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Стр = СтрЗаменить(Стр, " ", "T");
	Если СтрДлина(Стр) = 10 Тогда
		Стр = Стр + "T00:00:00";
	КонецЕсли;
	Попытка
		Возврат XMLЗначение(Тип("Дата"), Стр);
	Исключение
		ВызватьИсключение СтрШаблон("Не удалось разобрать период ""%1"". Ожидается дата в формате ГГГГ-ММ-ДД или ГГГГ-ММ-ДДTчч:мм:сс.", Строка(Значение));
	КонецПопытки;
КонецФункции

Функция СписокСтрок(Значение)
	Результат = Новый Массив;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Если ЗначениеЗаполнено(Элемент) Тогда
				Результат.Добавить(Строка(Элемент));
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(Значение) Тогда
		Результат.Добавить(Значение);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Строит выражение источника данных для запроса по FQN таблицы.
//
// Параметры:
//   ИмяТаблицы - Строка - FQN таблицы (основной, табличной части или виртуальной таблицы регистра).
//   Период - Дата - момент для виртуальной таблицы (может быть Неопределено).
//
// Возвращаемое значение:
//   Структура:
//     * Текст - Строка - выражение источника для секции ИЗ запроса.
//     * ИспользуетсяПериод - Булево - нужно ли передавать параметр Период.
Функция ВыражениеИсточника(ИмяТаблицы, Период)
	Части = СтрРазделить(ИмяТаблицы, ".");
	Если Части.Количество() < 2 Тогда
		ВызватьИсключение СтрШаблон("Некорректное имя таблицы: %1", ИмяТаблицы);
	КонецЕсли;
	ТипОбъекта = Части[0];
	ИмяОбъекта = Части[0] + "." + Части[1];
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ИмяОбъекта);
	Если ОбъектМетаданных = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Объект метаданных не найден: %1", ИмяОбъекта);
	КонецЕсли;
	Если НЕ ЕстьПравоЧтения(ОбъектМетаданных) Тогда
		ВызватьИсключение СтрШаблон("Нет права на чтение объекта: %1", ИмяОбъекта);
	КонецЕсли;

	Результат = Новый Структура("Текст, ИспользуетсяПериод", ИмяТаблицы, Ложь);
	Если Части.Количество() < 3 Тогда
		Возврат Результат;
	КонецЕсли;

	ИмяПодтаблицы = Части[2];
	ВиртуальныеТаблицы = ВиртуальныеТаблицыРегистра(ТипОбъекта, ОбъектМетаданных);
	Если ВиртуальныеТаблицы.Найти(ИмяПодтаблицы) = Неопределено Тогда
		// Табличная часть или иная подтаблица — обращаемся по полному имени.
		Возврат Результат;
	КонецЕсли;

	ПоддерживаетПериод = (ИмяПодтаблицы = "Остатки" ИЛИ ИмяПодтаблицы = "СрезПоследних" ИЛИ ИмяПодтаблицы = "СрезПервых");
	Если ПоддерживаетПериод И Период <> Неопределено Тогда
		Результат.Текст = ИмяОбъекта + "." + ИмяПодтаблицы + "(&Период)";
		Результат.ИспользуетсяПериод = Истина;
	Иначе
		Результат.Текст = ИмяОбъекта + "." + ИмяПодтаблицы + "()";
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ПостроитьСхемуЧтения(ВыражениеТаблицы, ИспользуетсяПериод, МаксСтрок)
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(МаксСтрок, "ЧГ=0") + " * ИЗ " + ВыражениеТаблицы + " КАК ТаблицаДанных";

	Схема = Новый СхемаКомпоновкиДанных;
	ИсточникДанных = Схема.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local";

	НаборДанных = Схема.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.Имя = "НаборДанных1";
	НаборДанных.ИсточникДанных = "ИсточникДанных1";
	НаборДанных.Запрос = ТекстЗапроса;
	НаборДанных.АвтоЗаполнениеДоступныхПолей = Истина;

	Если ИспользуетсяПериод Тогда
		ПараметрПериод = Схема.Параметры.Добавить();
		ПараметрПериод.Имя = "Период";
		ПараметрПериод.Заголовок = "Период";
		ПараметрПериод.ТипЗначения = Новый ОписаниеТипов("Дата");
	КонецЕсли;

	Возврат Схема;
КонецФункции

Функция ДоступныеИменаПолей(Настройки)
	Имена = Новый Соответствие;
	СобратьДоступныеПоля(Имена, Настройки.Выбор.ДоступныеПоляВыбора.Элементы);
	Возврат Имена;
КонецФункции

Процедура СобратьДоступныеПоля(Имена, Элементы)
	Для Каждого Элемент Из Элементы Цикл
		ИмяЭлемента = Строка(Элемент.Поле);
		// Служебные группы полей СКД (платформенные) в выборку данных не идут.
		Если ИмяЭлемента = "СистемныеПоля" ИЛИ ИмяЭлемента = "ПараметрыДанных" Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Элемент) = Тип("ДоступноеПолеКомпоновкиДанных") Тогда
			Имена.Вставить(ИмяЭлемента, Истина);
			// В ссылочные поля не углубляемся — их вложенные реквизиты доступны точечным путём.
		Иначе
			ВложенныеЭлементы = Неопределено;
			Попытка
				ВложенныеЭлементы = Элемент.Элементы;
			Исключение
				ВложенныеЭлементы = Неопределено;
			КонецПопытки;
			Если ВложенныеЭлементы <> Неопределено Тогда
				СобратьДоступныеПоля(Имена, ВложенныеЭлементы);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПолеДоступно(ИмяПоля, ДоступныеПоля)
	Если ДоступныеПоля.Получить(ИмяПоля) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	// Точечные пути (Номенклатура.Артикул) не перечисляются среди доступных — их проверит платформа.
	Возврат СтрНайти(ИмяПоля, ".") > 0;
КонецФункции

Процедура ПрименитьВыбор(ЦельВыбора, Поля, ДоступныеПоля, ИмяТаблицы)
	СписокПолей = СписокСтрок(Поля);
	Если СписокПолей.Количество() = 0 Тогда
		// Поля не заданы — выбираем все доступные поля таблицы.
		Для Каждого КлючЗначение Из ДоступныеПоля Цикл
			ДобавитьВыбранноеПоле(ЦельВыбора, КлючЗначение.Ключ);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	Для Каждого ИмяПоля Из СписокПолей Цикл
		Если НЕ ПолеДоступно(ИмяПоля, ДоступныеПоля) Тогда
			ВызватьИсключение СтрШаблон("Поле %1 недоступно в таблице %2. Список полей таблицы — инструмент describe с параметром table.", ИмяПоля, ИмяТаблицы);
		КонецЕсли;
		ДобавитьВыбранноеПоле(ЦельВыбора, ИмяПоля);
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьВыбранноеПоле(ЦельВыбора, ИмяПоля)
	ВыбранноеПоле = ЦельВыбора.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	ВыбранноеПоле.Использование = Истина;
КонецПроцедуры

Функция ВидСравненияОтбора(КодСравнения)
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("equal", ВидСравненияКомпоновкиДанных.Равно);
	Соответствие.Вставить("notequal", ВидСравненияКомпоновкиДанных.НеРавно);
	Соответствие.Вставить("greater", ВидСравненияКомпоновкиДанных.Больше);
	Соответствие.Вставить("greaterorequal", ВидСравненияКомпоновкиДанных.БольшеИлиРавно);
	Соответствие.Вставить("less", ВидСравненияКомпоновкиДанных.Меньше);
	Соответствие.Вставить("lessorequal", ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);
	Соответствие.Вставить("contains", ВидСравненияКомпоновкиДанных.Содержит);
	Соответствие.Вставить("notcontains", ВидСравненияКомпоновкиДанных.НеСодержит);
	Соответствие.Вставить("inlist", ВидСравненияКомпоновкиДанных.ВСписке);
	Соответствие.Вставить("notinlist", ВидСравненияКомпоновкиДанных.НеВСписке);
	Соответствие.Вставить("filled", ВидСравненияКомпоновкиДанных.Заполнено);
	Соответствие.Вставить("notfilled", ВидСравненияКомпоновкиДанных.НеЗаполнено);

	Результат = Соответствие.Получить(НРег(СокрЛП(КодСравнения)));
	Если Результат = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Неизвестный вид сравнения: %1. Допустимо: equal, notEqual, greater, greaterOrEqual, less, lessOrEqual, contains, notContains, inList, notInList, filled, notFilled.", КодСравнения);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ЗначениеОтбора(Значение, СравнениеЭлемента)
	Если СравнениеЭлемента = ВидСравненияКомпоновкиДанных.ВСписке ИЛИ СравнениеЭлемента = ВидСравненияКомпоновкиДанных.НеВСписке Тогда
		Список = Новый СписокЗначений;
		Если ТипЗнч(Значение) = Тип("Массив") Тогда
			Для Каждого Элемент Из Значение Цикл
				Список.Добавить(Элемент);
			КонецЦикла;
		ИначеЕсли Значение <> Неопределено Тогда
			Список.Добавить(Значение);
		КонецЕсли;
		Возврат Список;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Процедура ПрименитьОтборы(Настройки, Отборы, ДоступныеПоля, ИмяТаблицы)
	Если ТипЗнч(Отборы) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Отбор Из Отборы Цикл
		ИмяПоля = Строка(ЗначениеПараметра(Отбор, "field", ""));
		Если НЕ ЗначениеЗаполнено(ИмяПоля) Тогда
			ВызватьИсключение "В отборе не указано поле (field).";
		КонецЕсли;
		Если НЕ ПолеДоступно(ИмяПоля, ДоступныеПоля) Тогда
			ВызватьИсключение СтрШаблон("Поле отбора %1 недоступно в таблице %2.", ИмяПоля, ИмяТаблицы);
		КонецЕсли;
		СравнениеЭлемента = ВидСравненияОтбора(Строка(ЗначениеПараметра(Отбор, "comparison", "equal")));

		ЭлементОтбора = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
		ЭлементОтбора.ВидСравнения = СравнениеЭлемента;
		Если СравнениеЭлемента <> ВидСравненияКомпоновкиДанных.Заполнено И СравнениеЭлемента <> ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
			ЗначениеИзОтбора = RSVData_Анонимизация.РазмаскироватьЗначение(ЗначениеПараметра(Отбор, "value", Неопределено));
			ЭлементОтбора.ПравоеЗначение = ЗначениеОтбора(ЗначениеИзОтбора, СравнениеЭлемента);
		КонецЕсли;
		ЭлементОтбора.Использование = Истина;
	КонецЦикла;
КонецПроцедуры

Процедура ПрименитьПорядок(Настройки, Порядок, ДоступныеПоля, ИмяТаблицы)
	Если ТипЗнч(Порядок) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Элемент Из Порядок Цикл
		ИмяПоля = "";
		ПоУбыванию = Ложь;
		Если ТипЗнч(Элемент) = Тип("Строка") Тогда
			ИмяПоля = СокрЛП(Элемент);
			Если СтрНачинаетсяС(ИмяПоля, "-") Тогда
				ПоУбыванию = Истина;
				ИмяПоля = СокрЛП(Сред(ИмяПоля, 2));
			КонецЕсли;
		Иначе
			ИмяПоля = Строка(ЗначениеПараметра(Элемент, "field", ""));
			Направление = НРег(Строка(ЗначениеПараметра(Элемент, "direction", "asc")));
			ПоУбыванию = (Направление = "desc" ИЛИ Направление = "убыв");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ПолеДоступно(ИмяПоля, ДоступныеПоля) Тогда
			ВызватьИсключение СтрШаблон("Поле сортировки %1 недоступно в таблице %2.", ИмяПоля, ИмяТаблицы);
		КонецЕсли;
		ЭлементПорядка = Настройки.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
		ЭлементПорядка.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		ЭлементПорядка.ТипУпорядочивания = ?(ПоУбыванию, НаправлениеСортировкиКомпоновкиДанных.Убыв, НаправлениеСортировкиКомпоновкиДанных.Возр);
		ЭлементПорядка.Использование = Истина;
	КонецЦикла;
КонецПроцедуры

Функция ВыполнитьКомпоновку(Схема, Настройки)
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ТаблицаДанных = Новый ТаблицаЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаДанных);
	ПроцессорВывода.Вывести(Процессор);
	Возврат ТаблицаДанных;
КонецФункции

Функция ОписаниеКолонок(ТаблицаДанных)
	Колонки = Новый Массив;
	Для Каждого Колонка Из ТаблицаДанных.Колонки Цикл
		Колонки.Добавить(Новый Структура("Имя, Тип", Колонка.Имя, ПредставлениеТипа(Колонка.ТипЗначения)));
	КонецЦикла;
	Возврат Колонки;
КонецФункции

Функция СтрокиВыборки(ТаблицаДанных, Смещение, Лимит, ИмяТаблицы)
	АнонВключена = RSVData_Анонимизация.Включена();
	Кэш = ?(АнонВключена, Новый Соответствие, Неопределено);
	ЗаменыПоЗначению = Неопределено;
	ПарыВхождений = Неопределено;
	Если АнонВключена Тогда
		ДанныеСтраницы = ДанныеСтраницыДляСверки(ТаблицаДанных, Смещение, Лимит);
		ЗаменыПоЗначению = RSVData_Анонимизация.КартаЗаменПоЗначениям(
			ДанныеСтраницы.Значения, Кэш, ДанныеСтраницы.Ссылки);
		ПарыВхождений = RSVData_Анонимизация.ПарыДляПоискаВхождений(
			ЗаменыПоЗначению, ДанныеСтраницы.Ссылки, Кэш);
	КонецЕсли;
	Строки = Новый Массив;
	Индекс = Смещение;
	Пока Индекс < ТаблицаДанных.Количество() И Строки.Количество() < Лимит Цикл
		СтрокаТЗ = ТаблицаДанных[Индекс];
		Запись = Новый Соответствие;
		Для Каждого Колонка Из ТаблицаДанных.Колонки Цикл
			Значение = СтрокаТЗ[Колонка.Имя];
			Если АнонВключена Тогда
				Замаскированное = RSVData_Анонимизация.МаскироватьДляОтвета(Значение, Колонка.Имя, ИмяТаблицы, Кэш, ЗаменыПоЗначению);
				Если Замаскированное <> Неопределено Тогда
					Запись.Вставить(Колонка.Имя, Замаскированное);
					Продолжить;
				КонецЕсли;
				Если ТипЗнч(Значение) = Тип("Строка") Тогда
					СВхождениями = RSVData_Анонимизация.ЗаменитьВхожденияИмен(Значение, ПарыВхождений);
					Если СВхождениями <> Неопределено Тогда
						Запись.Вставить(Колонка.Имя, СВхождениями);
						Продолжить;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			Запись.Вставить(Колонка.Имя, ЗначениеДляОтвета(Значение));
		КонецЦикла;
		Строки.Добавить(Запись);
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Строки;
КонецФункции

// Данные страницы ответа для сверки анонимизации по значениям: уникальные строковые значения
// ячеек и встреченные в ячейках ссылки (для выбора победителя среди объектов-тёзок).
Функция ДанныеСтраницыДляСверки(ТаблицаДанных, Смещение, Лимит)
	Встреченные = Новый Соответствие;
	Значения = Новый Массив;
	Ссылки = Новый Соответствие;
	Индекс = Смещение;
	Пока Индекс < ТаблицаДанных.Количество() И Индекс - Смещение < Лимит Цикл
		СтрокаТЗ = ТаблицаДанных[Индекс];
		Для Каждого Колонка Из ТаблицаДанных.Колонки Цикл
			Значение = СтрокаТЗ[Колонка.Имя];
			ТипЗначения = ТипЗнч(Значение);
			Если ТипЗначения = Тип("Строка") Тогда
				Если Встреченные.Получить(Значение) = Неопределено Тогда
					Встреченные.Вставить(Значение, Истина);
					Значения.Добавить(Значение);
				КонецЕсли;
			ИначеЕсли ТипЗначения <> Тип("Число") И ТипЗначения <> Тип("Дата") И ТипЗначения <> Тип("Булево")
				И ТипЗначения <> Тип("Неопределено") И ТипЗначения <> Тип("Null") Тогда
				Ссылки.Вставить(Значение, Истина);
			КонецЕсли;
		КонецЦикла;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Новый Структура("Значения, Ссылки", Значения, Ссылки);
КонецФункции

Функция ЗначениеДляОтвета(Значение)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") ИЛИ ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Булево") ИЛИ ТипЗначения = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

Функция СформироватьОтветТаблицы(ИмяТаблицы, ТаблицаДанных, Смещение, Лимит, ЕстьЕщё)
	Строки = СтрокиВыборки(ТаблицаДанных, Смещение, Лимит, ИмяТаблицы);
	Результат = Новый Структура;
	Результат.Вставить("Таблица", ИмяТаблицы);
	Результат.Вставить("Колонки", ОписаниеКолонок(ТаблицаДанных));
	Результат.Вставить("Строки", Строки);
	Результат.Вставить("КоличествоСтрок", Строки.Количество());
	Результат.Вставить("Лимит", Лимит);
	Результат.Вставить("ЕстьЕщё", ЕстьЕщё);
	Возврат Результат;
КонецФункции

Процедура УстановитьПараметрыЗапроса(Запрос, Параметры)
	Если ТипЗнч(Параметры) <> Тип("Структура") И ТипЗнч(Параметры) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого КлючЗначение Из Параметры Цикл
		Значение = RSVData_Анонимизация.РазмаскироватьЗначение(КлючЗначение.Значение);
		Запрос.УстановитьПараметр(Строка(КлючЗначение.Ключ), ЗначениеПараметраЗапроса(Значение));
	КонецЦикла;
КонецПроцедуры

Функция ЗначениеПараметраЗапроса(Значение)
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Дата = ПрочитатьДатуISO(Значение);
		Если Дата <> Неопределено Тогда
			Возврат Дата;
		КонецЕсли;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Распознаёт ISO-строку даты, чтобы строковые параметры запроса с датой применялись как Дата,
// а обычные строки таковыми не трактовались.
//
// Параметры:
//   Значение - Строка - предполагаемая дата в формате ГГГГ-ММ-ДД или ГГГГ-ММ-ДДTчч:мм:сс.
//
// Возвращаемое значение:
//   Дата, Неопределено - распознанная дата либо Неопределено, если строка не похожа на дату.
Функция ПрочитатьДатуISO(Значение)
	Стр = СокрЛП(Строка(Значение));
	Если СтрДлина(Стр) <> 10 И СтрДлина(Стр) <> 19 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Сред(Стр, 5, 1) <> "-" ИЛИ Сред(Стр, 8, 1) <> "-" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Позиция = 1 По 4 Цикл
		Если СтрНайти("0123456789", Сред(Стр, Позиция, 1)) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	НормСтр = СтрЗаменить(Стр, " ", "T");
	Если СтрДлина(НормСтр) = 10 Тогда
		НормСтр = НормСтр + "T00:00:00";
	КонецЕсли;
	Попытка
		Возврат XMLЗначение(Тип("Дата"), НормСтр);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Возвращает значения перечисления (имя + синоним), если поле ссылается на перечисление
// (для проектирования отборов в запросах и показа пользователю).
//
// Параметры:
//   ОписаниеТиповПоля - ОписаниеТипов - типы поля.
//
// Возвращаемое значение:
//   Массив - значения перечисления, каждое структурой с полями Имя и Синоним; пустой, если поле не перечисление.
Функция ЗначенияПеречисления(ОписаниеТиповПоля)
	Значения = Новый Массив;
	Для Каждого ТипЗначения Из ОписаниеТиповПоля.Типы() Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
		Если ОбъектМетаданных <> Неопределено И Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
			Для Каждого ЗначениеПеречисления Из ОбъектМетаданных.ЗначенияПеречисления Цикл
				Синоним = ?(ПустаяСтрока(ЗначениеПеречисления.Синоним), ЗначениеПеречисления.Имя, ЗначениеПеречисления.Синоним);
				Значения.Добавить(Новый Структура("Имя, Синоним", ЗначениеПеречисления.Имя, Синоним));
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Значения;
КонецФункции

// Вычисляет поля виртуальной таблицы регистра (имена, которые реально доступны в запросе).
// Для накопления — измерения + ресурсы с суффиксами (Остаток/Оборот/Приход/Расход/...);
// для сведений (срез) — Период + измерения + ресурсы + реквизиты.
//
// Параметры:
//   ОбъектМетаданных - ОбъектМетаданных - регистр.
//   ТипОбъекта       - Строка - РегистрНакопления / РегистрСведений / ...
//   ИмяВиртуальной   - Строка - имя виртуальной таблицы (Остатки/Обороты/ОстаткиИОбороты/СрезПоследних/...).
//
// Возвращаемое значение:
//   Массив - поля виртуальной таблицы (структуры Имя/Тип/Вид/Синоним); пустой для нераспознанных таблиц.
Функция ПоляВиртуальнойТаблицы(ОбъектМетаданных, ТипОбъекта, ИмяВиртуальной)
	Поля = Новый Массив;
	Если ТипОбъекта = "РегистрНакопления" Тогда
		ДобавитьПоляКоллекции(Поля, ОбъектМетаданных.Измерения, "Измерение");
		Если ИмяВиртуальной = "Остатки" Тогда
			ДобавитьРесурсыССуффиксом(Поля, ОбъектМетаданных.Ресурсы, "Остаток");
		ИначеЕсли ИмяВиртуальной = "Обороты" Тогда
			ДобавитьРесурсыССуффиксом(Поля, ОбъектМетаданных.Ресурсы, "Оборот");
			ДобавитьРесурсыССуффиксом(Поля, ОбъектМетаданных.Ресурсы, "Приход");
			ДобавитьРесурсыССуффиксом(Поля, ОбъектМетаданных.Ресурсы, "Расход");
		ИначеЕсли ИмяВиртуальной = "ОстаткиИОбороты" Тогда
			ДобавитьРесурсыССуффиксом(Поля, ОбъектМетаданных.Ресурсы, "НачальныйОстаток");
			ДобавитьРесурсыССуффиксом(Поля, ОбъектМетаданных.Ресурсы, "Приход");
			ДобавитьРесурсыССуффиксом(Поля, ОбъектМетаданных.Ресурсы, "Расход");
			ДобавитьРесурсыССуффиксом(Поля, ОбъектМетаданных.Ресурсы, "Оборот");
			ДобавитьРесурсыССуффиксом(Поля, ОбъектМетаданных.Ресурсы, "КонечныйОстаток");
		КонецЕсли;
	ИначеЕсли ТипОбъекта = "РегистрСведений" Тогда
		Поля.Добавить(Новый Структура("Имя, Тип, Вид, Синоним", "Период", "Дата", "Поле", "Период"));
		ДобавитьПоляКоллекции(Поля, ОбъектМетаданных.Измерения, "Измерение");
		ДобавитьПоляКоллекции(Поля, ОбъектМетаданных.Ресурсы, "Ресурс");
		ДобавитьПоляКоллекции(Поля, ОбъектМетаданных.Реквизиты, "Реквизит");
	КонецЕсли;
	Возврат Поля;
КонецФункции

Процедура ДобавитьРесурсыССуффиксом(Поля, Ресурсы, Суффикс)
	Для Каждого Ресурс Из Ресурсы Цикл
		Синоним = ?(ПустаяСтрока(Ресурс.Синоним), Ресурс.Имя, Ресурс.Синоним);
		Поля.Добавить(Новый Структура("Имя, Тип, Вид, Синоним",
			Ресурс.Имя + Суффикс, ПредставлениеТипа(Ресурс.Тип), "Ресурс", Синоним + " (" + Суффикс + ")"));
	КонецЦикла;
КонецПроцедуры

#КонецОбласти


#Область ОбзорКонфигурации

// Возвращает «паспорт» базы: имя/версия/поставщик/режим совместимости конфигурации,
// список подключённых расширений и обзор подсистем (бизнес-разделов) верхнего уровня.
//
// Возвращаемое значение:
//   Структура - Имя, Синоним, Версия, Поставщик, РежимСовместимости конфигурации;
//               Расширения (Массив), Подсистемы (Массив) верхнего уровня.
Функция ИнформацияОКонфигурации() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя", Метаданные.Имя);
	Результат.Вставить("Синоним", Метаданные.Синоним);
	Результат.Вставить("Версия", Метаданные.Версия);
	Результат.Вставить("Поставщик", Метаданные.Поставщик);
	Результат.Вставить("РежимСовместимости", Строка(Метаданные.РежимСовместимости));
	Если Не ПустаяСтрока(Метаданные.КраткаяИнформация) Тогда
		Результат.Вставить("КраткаяИнформация", Метаданные.КраткаяИнформация);
	КонецЕсли;
	Результат.Вставить("Расширения", СписокРасширений());
	Результат.Вставить("Подсистемы", ОбзорПодсистем());
	Возврат Результат;
КонецФункции

// Возвращает объекты бизнес-раздела (подсистемы) и её вложенные подсистемы.
//
// Параметры:
//   ИмяПодсистемы - Строка - имя раздела (Продажи) или путь (Продажи.ОптовыеПродажи).
//
// Возвращаемое значение:
//   Структура - Подсистема (Строка), Синоним (Строка), Объекты (Массив), ВложенныеПодсистемы (Массив).
Функция ПодсистемаДетально(ИмяПодсистемы) Экспорт
	Если ПустаяСтрока(ИмяПодсистемы) Тогда
		ВызватьИсключение "Не задано имя подсистемы (параметр subsystem). Список разделов — в инструменте config.";
	КонецЕсли;
	Подсистема = НайтиПодсистему(СокрЛП(ИмяПодсистемы));
	Если Подсистема = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Подсистема не найдена: %1. Список разделов верхнего уровня — в инструменте config.", ИмяПодсистемы);
	КонецЕсли;

	Объекты = Новый Массив;
	Для Каждого ОбъектМетаданных Из Подсистема.Состав Цикл
		Если ЕстьПравоЧтения(ОбъектМетаданных) Тогда
			Синоним = ?(ПустаяСтрока(ОбъектМетаданных.Синоним), ОбъектМетаданных.Имя, ОбъектМетаданных.Синоним);
			Объекты.Добавить(Новый Структура("ПолноеИмя, Синоним", ОбъектМетаданных.ПолноеИмя(), Синоним));
		КонецЕсли;
	КонецЦикла;

	Вложенные = Новый Массив;
	Для Каждого Дочерняя Из Подсистема.Подсистемы Цикл
		Вложенные.Добавить(Новый Структура("Имя, Синоним",
			Дочерняя.Имя, ?(ПустаяСтрока(Дочерняя.Синоним), Дочерняя.Имя, Дочерняя.Синоним)));
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Подсистема", Подсистема.Имя);
	Результат.Вставить("Синоним", ?(ПустаяСтрока(Подсистема.Синоним), Подсистема.Имя, Подсистема.Синоним));
	Результат.Вставить("Объекты", Объекты);
	Результат.Вставить("ВложенныеПодсистемы", Вложенные);
	Возврат Результат;
КонецФункции

// Глобальный поиск объекта по подстроке во ВСЕХ поддерживаемых категориях сразу.
//
// Параметры:
//   Подстрока - Строка - искомая подстрока в имени или синониме (без учёта регистра).
//   Лимит     - Число  - максимум результатов (по умолчанию 100, максимум 1000).
//
// Возвращаемое значение:
//   Структура - Подстрока, Найдено (Массив), КоличествоСтрок, Лимит, ЕстьЕщё.
Функция ГлобальныйПоиск(Подстрока, Лимит = Неопределено) Экспорт
	Если ПустаяСтрока(Подстрока) Тогда
		ВызватьИсключение "Не задана подстрока для поиска (параметр find).";
	КонецЕсли;
	МаксСтрок = НормализованныйЛимит(Лимит);
	Найдено = Новый Массив;
	Обрезано = Ложь;
	Для Каждого ОписаниеТипа Из ДоступныеТипы() Цикл
		Для Каждого Объект Из ДоступныеОбъекты(ОписаниеТипа.Тип, Подстрока) Цикл
			Если Найдено.Количество() >= МаксСтрок Тогда
				Обрезано = Истина;
				Прервать;
			КонецЕсли;
			Найдено.Добавить(Новый Структура("Тип, Имя, ПолноеИмя, Синоним",
				ОписаниеТипа.Тип, Объект.Имя, Объект.ПолноеИмя, Объект.Синоним));
		КонецЦикла;
		Если Обрезано Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Подстрока", Подстрока);
	Результат.Вставить("Найдено", Найдено);
	Результат.Вставить("КоличествоСтрок", Найдено.Количество());
	Результат.Вставить("Лимит", МаксСтрок);
	Результат.Вставить("ЕстьЕщё", Обрезано);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныйОбзор

Функция СписокРасширений()
	Результат = Новый Массив;
	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Результат.Добавить(Новый Структура("Имя, Синоним, Версия, Активно, Назначение",
			Расширение.Имя,
			Расширение.Синоним,
			Расширение.Версия,
			Расширение.Активно,
			Строка(Расширение.Назначение)));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ОбзорПодсистем()
	Результат = Новый Массив;
	Для Каждого Подсистема Из Метаданные.Подсистемы Цикл
		Результат.Добавить(Новый Структура("Имя, Синоним, КоличествоОбъектов, ЕстьВложенные",
			Подсистема.Имя,
			?(ПустаяСтрока(Подсистема.Синоним), Подсистема.Имя, Подсистема.Синоним),
			Подсистема.Состав.Количество(),
			Подсистема.Подсистемы.Количество() > 0));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НайтиПодсистему(Путь)
	Если СтрНайти(Путь, ".") > 0 Тогда
		Коллекция = Метаданные.Подсистемы;
		Подсистема = Неопределено;
		Для Каждого Часть Из СтрРазделить(Путь, ".", Ложь) Цикл
			Если Коллекция = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Подсистема = Коллекция.Найти(СокрЛП(Часть));
			Если Подсистема = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Коллекция = Подсистема.Подсистемы;
		КонецЦикла;
		Возврат Подсистема;
	КонецЕсли;
	Возврат НайтиПодсистемуРекурсивно(Метаданные.Подсистемы, Путь);
КонецФункции

Функция НайтиПодсистемуРекурсивно(Коллекция, Имя)
	ИмяВРег = ВРег(Имя);
	Для Каждого Подсистема Из Коллекция Цикл
		Если ВРег(Подсистема.Имя) = ИмяВРег Тогда
			Возврат Подсистема;
		КонецЕсли;
		Найдено = НайтиПодсистемуРекурсивно(Подсистема.Подсистемы, Имя);
		Если Найдено <> Неопределено Тогда
			Возврат Найдено;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

#КонецОбласти



#Область ЖурналРегистрации

// Читает записи журнала регистрации с платформенным отбором (ВыгрузитьЖурналРегистрации).
//
// Параметры:
//   Аргументы - Соответствие - аргументы инструмента eventlog:
//     from, to             - даты периода (ГГГГ-ММ-ДД или с временем);
//     levels               - уровни (Ошибка/Error, Предупреждение/Warning, Информация/Information, Примечание/Note);
//     applications         - точные идентификаторы приложений (1CV8, BackgroundJob, COMConnection...);
//     users                - имена пользователей ИБ;
//     computers            - имена компьютеров;
//     events               - точные системные имена событий (_$PerformError$_, _$Data$_.Update...);
//     metadata             - FQN объекта метаданных (Документ.ЗаказКлиента);
//     session              - номер сеанса;
//     transaction          - идентификатор транзакции;
//     comment              - ТОЧНОЕ равенство комментария (так ищет платформа);
//     commentContains      - подстрока комментария (пост-фильтрация по последним scan записям);
//     scan                 - сколько последних записей сканировать при commentContains (5000 по умолчанию, до 20000);
//     dataPresentation     - точное представление данных;
//     columns              - какие колонки вернуть (en/ru; по умолчанию компактный набор без data);
//     limit                - сколько последних записей вернуть (100 по умолчанию, до 1000).
//
// Возвращаемое значение:
//   Структура - records, totalScanned, totalMatched, returned, limit, scan, hasMore, filter, commentContains.
Функция ПрочитатьЖурнал(Аргументы) Экспорт
	Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		Аргументы = Новый Соответствие;
	КонецЕсли;

	Отбор = Новый Структура;
	ДатаНачала = ПериодИзЗначения(Аргументы.Получить("from"));
	Если ДатаНачала <> Неопределено Тогда
		Отбор.Вставить("ДатаНачала", ДатаНачала);
	КонецЕсли;
	ДатаОкончания = ГраницаОкончания(Аргументы.Получить("to"));
	Если ДатаОкончания <> Неопределено Тогда
		Отбор.Вставить("ДатаОкончания", ДатаОкончания);
	КонецЕсли;
	СписокУровней = УровниЖурнала(СписокСтрок(Аргументы.Получить("levels")));
	Если СписокУровней.Количество() > 0 Тогда
		Отбор.Вставить("Уровень", СписокУровней);
	КонецЕсли;
	ИменаПриложений = СписокСтрок(Аргументы.Получить("applications"));
	Если ИменаПриложений.Количество() > 0 Тогда
		Отбор.Вставить("ИмяПриложения", ИменаПриложений);
	КонецЕсли;
	ИменаПользователей = СписокСтрок(Аргументы.Получить("users"));
	Если ИменаПользователей.Количество() > 0 Тогда
		Отбор.Вставить("Пользователь", ИменаПользователей);
	КонецЕсли;
	ИменаКомпьютеров = СписокСтрок(Аргументы.Получить("computers"));
	Если ИменаКомпьютеров.Количество() > 0 Тогда
		Отбор.Вставить("Компьютер", ИменаКомпьютеров);
	КонецЕсли;
	ИменаСобытий = СписокСтрок(Аргументы.Получить("events"));
	Если ИменаСобытий.Количество() > 0 Тогда
		Отбор.Вставить("Событие", ИменаСобытий);
	КонецЕсли;
	ИмяОбъекта = СокрЛП(Строка(Аргументы.Получить("metadata")));
	Если ЗначениеЗаполнено(ИмяОбъекта) Тогда
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ИмяОбъекта);
		Если ОбъектМетаданных = Неопределено Тогда
			ВызватьИсключение СтрШаблон("Объект метаданных ""%1"" не найден (параметр metadata).", ИмяОбъекта);
		КонецЕсли;
		Отбор.Вставить("Метаданные", ОбъектМетаданных);
	КонецЕсли;
	НомерСеанса = ЦелоеЗначение(Аргументы.Получить("session"), 0);
	Если НомерСеанса > 0 Тогда
		Отбор.Вставить("Сеанс", НомерСеанса);
	КонецЕсли;
	ИдентификаторТранзакции = СокрЛП(Строка(Аргументы.Получить("transaction")));
	Если ЗначениеЗаполнено(ИдентификаторТранзакции) Тогда
		Отбор.Вставить("Транзакция", ИдентификаторТранзакции);
	КонецЕсли;
	ТочныйКомментарий = Строка(Аргументы.Получить("comment"));
	Если ЗначениеЗаполнено(ТочныйКомментарий) Тогда
		Отбор.Вставить("Комментарий", ТочныйКомментарий);
	КонецЕсли;
	ПредставлениеДанных = СокрЛП(Строка(Аргументы.Получить("dataPresentation")));
	Если ЗначениеЗаполнено(ПредставлениеДанных) Тогда
		Отбор.Вставить("ПредставлениеДанных", ПредставлениеДанных);
	КонецЕсли;

	Лимит = НормализованныйЛимит(Аргументы.Получить("limit"));
	КомментарийСодержит = СокрЛП(Строка(Аргументы.Получить("commentContains")));
	КолонкиЖР = КолонкиВыгрузки(Аргументы.Получить("columns"));
	Скан = 0;
	Если ЗначениеЗаполнено(КомментарийСодержит) Тогда
		Если СтрНайти(ВРег(КолонкиЖР), "КОММЕНТАРИЙ") = 0 Тогда
			ВызватьИсключение "commentContains требует колонку comment (добавьте её в columns или уберите columns).";
		КонецЕсли;
		Скан = ЦелоеЗначение(Аргументы.Получить("scan"), 0);
		Если Скан <= 0 Тогда
			Скан = 5000;
		ИначеЕсли Скан > 20000 Тогда
			Скан = 20000;
		КонецЕсли;
	Иначе
		Скан = Лимит;
	КонецЕсли;

	Таблица = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Таблица, Отбор, КолонкиЖР, , Скан);

	Совпало = 0;
	Если ЗначениеЗаполнено(КомментарийСодержит) Тогда
		ПодстрокаВРег = ВРег(КомментарийСодержит);
		Подходящие = Новый Массив;
		Для Каждого СтрокаЖР Из Таблица Цикл
			Если СтрНайти(ВРег(Строка(СтрокаЖР.Комментарий)), ПодстрокаВРег) > 0 Тогда
				Подходящие.Добавить(СтрокаЖР);
			КонецЕсли;
		КонецЦикла;
		Совпало = Подходящие.Количество();
		Выбранные = ПоследниеСтроки(Подходящие, Лимит);
	Иначе
		Совпало = Таблица.Количество();
		Выбранные = ПоследниеСтроки(Таблица, Лимит);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("records", ЗаписиЖурнала(Выбранные));
	Результат.Вставить("totalScanned", Таблица.Количество());
	Результат.Вставить("totalMatched", Совпало);
	Результат.Вставить("returned", Выбранные.Количество());
	Результат.Вставить("limit", Лимит);
	Результат.Вставить("scan", Скан);
	Результат.Вставить("hasMore", Совпало > Выбранные.Количество());
	Результат.Вставить("filter", СериализуемыйОтбор(Отбор));
	Результат.Вставить("commentContains", КомментарийСодержит);
	Возврат Результат;
КонецФункции

// Копия отбора журнала регистрации, безопасная для ЗаписатьJSON:
// перечисления (уровни) - строками, даты - ISO-строками, метаданные - полным именем.
Функция СериализуемыйОтбор(Отбор)
	Результат = Новый Структура;
	Для Каждого КлючЗначение Из Отбор Цикл
		Имя = КлючЗначение.Ключ;
		Значение = КлючЗначение.Значение;
		Если Имя = "Метаданные" И Значение <> Неопределено Тогда
			Значение = Значение.ПолноеИмя();
		ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
			Значение = XMLСтрока(Значение);
		КонецЕсли;
		Результат.Вставить(Имя, ЗначениеЗаписи(Значение));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Возвращает допустимые значения отборов журнала регистрации (ПолучитьЗначенияОтбораЖурналаРегистрации)
// с серверной фильтрацией по подстроке: агенту отдаются только совпавшие значения.
//
// Параметры:
//   Аргументы - Соответствие - valueColumns (наборы: application, event, user, computer, metadata, server;
//               по умолчанию application и event), filter (подстрока поиска по значению и представлению).
//
// Возвращаемое значение:
//   Структура - FilterValues: по каждому набору total (до фильтра), matched, values (value + presentation).
Функция ЗначенияОтбораЖурнала(Аргументы) Экспорт
	Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		Аргументы = Новый Соответствие;
	КонецЕсли;
	Фильтр = ВРег(СокрЛП(Строка(Аргументы.Получить("filter"))));
	ИменаНаборов = СписокСтрок(Аргументы.Получить("valueColumns"));
	Если ИменаНаборов.Количество() = 0 Тогда
		ИменаНаборов.Добавить("application");
		ИменаНаборов.Добавить("event");
	КонецЕсли;
	Колонки = "";
	Для Каждого Имя Из ИменаНаборов Цикл
		КолонкаЖР = КолонкаЗначенийОтбора(Имя);
		Если КолонкаЖР = Неопределено Тогда
			ВызватьИсключение СтрШаблон("Неизвестный набор значений отбора ""%1"". Допустимые: application, event, user, computer, metadata, server.", Имя);
		КонецЕсли;
		Колонки = ?(Колонки = "", КолонкаЖР, Колонки + "," + КолонкаЖР);
	КонецЦикла;

	ЗначенияЖР = ПолучитьЗначенияОтбораЖурналаРегистрации(Колонки);
	Наборы = Новый Структура;
	Для Каждого Имя Из ИменаНаборов Цикл
		Наборы.Вставить(НРег(Имя), НаборЗначенийОтбора(ЗначенияЖР, КолонкаЗначенийОтбора(Имя), Фильтр));
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("filter", Фильтр);
	Результат.Вставить("FilterValues", Наборы);
	Возврат Результат;
КонецФункции

Функция ГраницаОкончания(Значение)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	Стр = СокрЛП(Строка(Значение));
	Если СтрДлина(Стр) = 10 Тогда
		Возврат ПериодИзЗначения(Стр + "T23:59:59");
	КонецЕсли;
	Момент = ПериодИзЗначения(Стр);
	Возврат ?(Момент = Неопределено, Неопределено, Момент + 1);
КонецФункции

Функция УровниЖурнала(Имена)
	Результат = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Ключ = НРег(СокрЛП(Имя));
		Если Ключ = "ошибка" ИЛИ Ключ = "error" Тогда
			Результат.Добавить(УровеньЖурналаРегистрации.Ошибка);
		ИначеЕсли Ключ = "предупреждение" ИЛИ Ключ = "warning" Тогда
			Результат.Добавить(УровеньЖурналаРегистрации.Предупреждение);
		ИначеЕсли Ключ = "информация" ИЛИ Ключ = "info" ИЛИ Ключ = "information" Тогда
			Результат.Добавить(УровеньЖурналаРегистрации.Информация);
		ИначеЕсли Ключ = "примечание" ИЛИ Ключ = "note" Тогда
			Результат.Добавить(УровеньЖурналаРегистрации.Примечание);
		Иначе
			ВызватьИсключение СтрШаблон("Неизвестный уровень журнала ""%1"". Допустимые: Ошибка(Error), Предупреждение(Warning), Информация(Information), Примечание(Note).", Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция КолонкаЗначенийОтбора(Имя)
	Ключ = НРег(СокрЛП(Имя));
	Если Ключ = "application" Тогда
		Возврат "ИмяПриложения";
	ИначеЕсли Ключ = "event" Тогда
		Возврат "Событие";
	ИначеЕсли Ключ = "user" Тогда
		Возврат "Пользователь";
	ИначеЕсли Ключ = "computer" Тогда
		Возврат "Компьютер";
	ИначеЕсли Ключ = "metadata" Тогда
		Возврат "Метаданные";
	ИначеЕсли Ключ = "server" Тогда
		Возврат "РабочийСервер";
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция НаборЗначенийОтбора(ЗначенияЖР, КлючЖР, Фильтр)
	Всего = 0;
	Совпадения = Новый Массив;
	Значение = Неопределено;
	Если ЗначенияЖР.Свойство(КлючЖР, Значение) Тогда
		Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
			Для Каждого Пара Из Значение Цикл
				Всего = Всего + 1;
				Если ПодходитЗначение(Строка(Пара.Ключ) + " " + Строка(Пара.Значение), Фильтр) Тогда
					Совпадения.Добавить(ЭлементЗначенияОтбора(Строка(Пара.Ключ), Строка(Пара.Значение)));
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
			Для Каждого Элемент Из Значение Цикл
				Всего = Всего + 1;
				Если ПодходитЗначение(Строка(Элемент), Фильтр) Тогда
					Совпадения.Добавить(ЭлементЗначенияОтбора(Строка(Элемент), Строка(Элемент)));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("total", Всего);
	Результат.Вставить("matched", Совпадения.Количество());
	Если Совпадения.Количество() > 300 Тогда
		Усечённые = Новый Массив;
		Для Индекс = 0 По 299 Цикл
			Усечённые.Добавить(Совпадения[Индекс]);
		КонецЦикла;
		Совпадения = Усечённые;
		Результат.Вставить("truncated", Истина);
	КонецЕсли;
	Результат.Вставить("values", Совпадения);
	Возврат Результат;
КонецФункции

Функция ПодходитЗначение(Текст, Фильтр)
	Возврат Фильтр = "" ИЛИ СтрНайти(ВРег(Текст), Фильтр) > 0;
КонецФункции

Функция ЭлементЗначенияОтбора(Значение, Представление)
	Элемент = Новый Структура;
	Элемент.Вставить("value", Значение);
	Элемент.Вставить("presentation", Представление);
	Возврат Элемент;
КонецФункции

Функция КолонкиВыгрузки(Значение)
	Имена = СписокСтрок(Значение);
	Если Имена.Количество() = 0 Тогда
		Возврат "Дата,Уровень,ИмяПользователя,Компьютер,ИмяПриложения,ПредставлениеПриложения,Событие,ПредставлениеСобытия,Метаданные,ПредставлениеМетаданных,ПредставлениеДанных,Комментарий,Сеанс,Соединение,Транзакция";
	КонецЕсли;
	Русские = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Русское = РусскоеИмяКолонки(Имя);
		Если Русское = Неопределено Тогда
			ВызватьИсключение СтрШаблон("Неизвестная колонка журнала ""%1"". Допустимые (en/ru): date, level, user, userName, computer, application, applicationPresentation, event, eventPresentation, metadata, metadataPresentation, dataPresentation, data, comment, session, connection, transaction, transactionStatus, server, port, syncPort.", Имя);
		КонецЕсли;
		Русские.Добавить(Русское);
	КонецЦикла;
	Возврат СтрСоединить(Русские, ",");
КонецФункции

Функция РусскоеИмяКолонки(Имя)
	ИмяСокр = СокрЛП(Имя);
	Для Каждого Пара Из КлючиКолонок() Цикл
		Если Пара.Ключ = ИмяСокр ИЛИ ВРег(Пара.Значение) = ВРег(ИмяСокр) Тогда
			Возврат Пара.Ключ;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция КлючиКолонок()
	Ключи = Новый Соответствие;
	Ключи.Вставить("Дата", "date");
	Ключи.Вставить("Уровень", "level");
	Ключи.Вставить("Пользователь", "user");
	Ключи.Вставить("ИмяПользователя", "userName");
	Ключи.Вставить("Компьютер", "computer");
	Ключи.Вставить("ИмяПриложения", "application");
	Ключи.Вставить("ПредставлениеПриложения", "applicationPresentation");
	Ключи.Вставить("Событие", "event");
	Ключи.Вставить("ПредставлениеСобытия", "eventPresentation");
	Ключи.Вставить("Метаданные", "metadata");
	Ключи.Вставить("ПредставлениеМетаданных", "metadataPresentation");
	Ключи.Вставить("ПредставлениеДанных", "dataPresentation");
	Ключи.Вставить("Данные", "data");
	Ключи.Вставить("Комментарий", "comment");
	Ключи.Вставить("Сеанс", "session");
	Ключи.Вставить("Соединение", "connection");
	Ключи.Вставить("Транзакция", "transaction");
	Ключи.Вставить("СтатусТранзакции", "transactionStatus");
	Ключи.Вставить("РабочийСервер", "server");
	Ключи.Вставить("ОсновнойIPПорт", "port");
	Ключи.Вставить("ВспомогательныйIPПорт", "syncPort");
	Возврат Ключи;
КонецФункции

Функция КлючКолонки(РусскоеИмя)
	Английский = КлючиКолонок().Получить(РусскоеИмя);
	Возврат ?(Английский = Неопределено, РусскоеИмя, Английский);
КонецФункции

Функция ЗаписиЖурнала(Строки)
	Записи = Новый Массив;
	Для Каждого СтрокаЖР Из Строки Цикл
		Запись = Новый Структура;
		Для Каждого Колонка Из СтрокаЖР.Владелец().Колонки Цикл
			Значение = СтрокаЖР[Колонка.Имя];
			Если ТипЗнч(Значение) = Тип("Дата") Тогда
				Значение = XMLСтрока(Значение);
			ИначеЕсли Колонка.Имя = "Комментарий" Тогда
				Значение = УсечьТекст(Строка(Значение), 4000);
			Иначе
				Значение = ЗначениеЗаписи(Значение);
			КонецЕсли;
			Запись.Вставить(КлючКолонки(Колонка.Имя), Значение);
		КонецЦикла;
		Записи.Добавить(Запись);
	КонецЦикла;
	Возврат Записи;
КонецФункции

// Рекурсивно приводит произвольное значение к сериализуемому в JSON:
// даты - в ISO-строку, вложенные коллекции обходятся, прочее (перечисления,
// UUID, объекты метаданных, хранилища) - в строку представления.
Функция ЗначениеЗаписи(Значение)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЗнач = ТипЗнч(Значение);
	Если ТипЗнач = Тип("Строка") ИЛИ ТипЗнач = Тип("Число") ИЛИ ТипЗнач = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнач = Тип("Дата") Тогда
		Возврат XMLСтрока(Значение);
	КонецЕсли;
	Если ТипЗнач = Тип("Структура") Тогда
		Результат = Новый Структура;
		Для Каждого КлючЗначение Из Значение Цикл
			Результат.Вставить(КлючЗначение.Ключ, ЗначениеЗаписи(КлючЗначение.Значение));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнач = Тип("Соответствие") Тогда
		Результат = Новый Соответствие;
		Для Каждого КлючЗначение Из Значение Цикл
			Результат.Вставить(Строка(КлючЗначение.Ключ), ЗначениеЗаписи(КлючЗначение.Значение));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнач = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ЗначениеЗаписи(Элемент));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

Функция УсечьТекст(Знач Текст, Максимум)
	Если СтрДлина(Текст) <= Максимум Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, Максимум) + СтрШаблон(" …(обрезано, всего %1 симв.)", СтрДлина(Текст));
КонецФункции

Функция ПоследниеСтроки(Строки, Лимит)
	Всего = Строки.Количество();
	Если Всего <= Лимит Тогда
		Возврат Строки;
	КонецЕсли;
	Результат = Новый Массив;
	Для Индекс = Всего - Лимит По Всего - 1 Цикл
		Результат.Добавить(Строки[Индекс]);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти
