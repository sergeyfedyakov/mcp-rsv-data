Функция ВыполнитьРасшифровку(Аргументы)
	Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		Аргументы = Новый Соответствие;
	КонецЕсли;
	Текст = Аргументы.Получить("text");
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат РезультатТекст("Не указан текст для расшифровки (параметр text).", Истина);
	КонецЕсли;
	Возврат РезультатТекст(RSVData_Анонимизация.РазмаскироватьТекст(Текст), Ложь);
КонецФункции

Функция СхемаРасшифровки()
	Свойства = Новый Структура;
	Свойства.Вставить("text", СвойствоСхемы("string",
		"Текст с токенами анонимизации (например [ОРГ-00001]) — обычно финальный ответ для пользователя; токены заменяются реальными значениями. Обязательный."));

	Обязательные = Новый Массив;
	Обязательные.Добавить("text");

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", Обязательные);
	Возврат Схема;
КонецФункции

Функция ВыполнитьЖурнал(Аргументы)
	Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		Аргументы = Новый Соответствие;
	КонецЕсли;
	Попытка
		Если Аргументы.Получить("values") = Истина Тогда
			Данные = RSVData_Ядро.ЗначенияОтбораЖурнала(Аргументы);
		Иначе
			Данные = RSVData_Ядро.ПрочитатьЖурнал(Аргументы);
		КонецЕсли;
	Исключение
		Возврат РезультатТекст(ОписаниеОшибки(), Истина);
	КонецПопытки;
	Возврат РезультатТекст(ВJSON(Данные), Ложь);
КонецФункции

Функция СхемаЖурнала()
	Свойства = Новый Структура;
	Свойства.Вставить("from", СвойствоСхемы("string",
		"Начало периода: ГГГГ-ММ-ДД или ГГГГ-ММ-ДДTчч:мм:сс."));
	Свойства.Вставить("to", СвойствоСхемы("string",
		"Конец периода (включительно): ГГГГ-ММ-ДД (весь день) или ГГГГ-ММ-ДДTчч:мм:сс."));
	Свойства.Вставить("levels", СписокСтрокСхемы("Уровни: Ошибка/Error, Предупреждение/Warning, Информация/Information, Примечание/Note."));
	Свойства.Вставить("applications", СписокСтрокСхемы("Точные идентификаторы приложений (1CV8, BackgroundJob, COMConnection, WebServer...). Допустимые значения: values=true, valueColumns=[application]."));
	Свойства.Вставить("users", СписокСтрокСхемы("Имена пользователей информационной базы (точно); фоновые задания пишут от имени пользователя, назначенного регламентному заданию."));
	Свойства.Вставить("computers", СписокСтрокСхемы("Имена компьютеров (точно)."));
	Свойства.Вставить("events", СписокСтрокСхемы("ТОЧНЫЕ системные имена событий: _$PerformError$_ (Ошибка выполнения), _$Data$_.Update, _$Session$_.Start и т.п. Список допустимых: values=true, valueColumns=[event], filter=<подстрока>."));
	Свойства.Вставить("metadata", СвойствоСхемы("string",
		"FQN объекта метаданных (Документ.ЗаказКлиента) — точный отбор по объекту."));
	Свойства.Вставить("session", СвойствоСхемы("integer", "Номер сеанса."));
	Свойства.Вставить("transaction", СвойствоСхемы("string", "Идентификатор транзакции."));
	Свойства.Вставить("comment", СвойствоСхемы("string",
		"ТОЧНОЕ равенство комментария (платформа ищет равенство, НЕ подстроку). Для подстроки — commentContains."));
	Свойства.Вставить("commentContains", СвойствоСхемы("string",
		"Поиск подстроки в комментарии без учёта регистра — серверная пост-фильтрация последних scan записей."));
	Свойства.Вставить("scan", СвойствоСхемы("integer",
		"Сколько последних записей сканировать при commentContains (по умолчанию 5000, максимум 20000)."));
	Свойства.Вставить("dataPresentation", СвойствоСхемы("string", "Точное представление данных."));
	Свойства.Вставить("columns", СписокСтрокСхемы("Какие колонки вернуть (en/ru): date, level, user, userName, computer, application, applicationPresentation, event, eventPresentation, metadata, metadataPresentation, dataPresentation, data, comment, session, connection, transaction, transactionStatus, server, port, syncPort. По умолчанию компактный набор без data."));
	Свойства.Вставить("limit", СвойствоСхемы("integer",
		"Максимум записей (последние в хронологическом порядке; по умолчанию 100, максимум 1000)."));
	Свойства.Вставить("values", СвойствоСхемы("boolean",
		"Режим получения допустимых значений отборов вместо записей журнала."));
	Свойства.Вставить("valueColumns", СписокСтрокСхемы("Для values: наборы application, event, user, computer, metadata, server. По умолчанию application и event."));
	Свойства.Вставить("filter", СвойствоСхемы("string",
		"Для values: подстрока фильтрации значений (по значению и представлению, без учёта регистра)."));

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Возврат Схема;
КонецФункции

Функция СписокСтрокСхемы(Описание)
	Поле = Новый Структура;
	Поле.Вставить("type", "array");
	Поле.Вставить("items", Новый Структура("type", "string"));
	Поле.Вставить("description", Описание);
	Возврат Поле;
КонецФункции

