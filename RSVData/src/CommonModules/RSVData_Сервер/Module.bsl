#Область ПрограммныйИнтерфейс

// Обрабатывает входящее MCP-сообщение (JSON-RPC 2.0) и возвращает текст ответа в формате JSON.
// Транспорт-независимо: вызывается из HTTP-сервиса и (в будущем) из COM-моста.
//
// Параметры:
//   ТекстСообщения - Строка - тело запроса (JSON-RPC).
//
// Возвращаемое значение:
//   Строка - JSON ответа; пустая строка, если ответ не требуется (уведомление).
Функция ОбработатьСообщение(ТекстСообщения) Экспорт
	Попытка
		Сообщение = ПрочитатьJSONОбъект(ТекстСообщения);
	Исключение
		Возврат ВJSON(ОтветОшибка(Неопределено, -32700, "Ошибка разбора JSON"));
	КонецПопытки;

	Если ТипЗнч(Сообщение) <> Тип("Соответствие") Тогда
		Возврат ВJSON(ОтветОшибка(Неопределено, -32600, "Ожидался объект JSON-RPC"));
	КонецЕсли;

	Метод = Сообщение.Получить("method");
	Идентификатор = Сообщение.Получить("id");
	Параметры = Сообщение.Получить("params");

	// Уведомления (без id) ответа не требуют.
	Если Идентификатор = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если Метод = "initialize" Тогда
		Возврат ВJSON(ОтветРезультат(Идентификатор, РезультатИнициализации(Параметры)));
	ИначеЕсли Метод = "tools/list" Тогда
		Возврат ВJSON(ОтветРезультат(Идентификатор, Новый Структура("tools", СписокИнструментов())));
	ИначеЕсли Метод = "tools/call" Тогда
		Возврат ВJSON(ВызватьИнструмент(Идентификатор, Параметры));
	ИначеЕсли Метод = "ping" Тогда
		Возврат ВJSON(ОтветРезультат(Идентификатор, Новый Структура));
	Иначе
		Возврат ВJSON(ОтветОшибка(Идентификатор, -32601, "Метод не поддерживается: " + Строка(Метод)));
	КонецЕсли;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РезультатИнициализации(Параметры)
	ВерсияПротокола = "2024-11-05";
	Если ТипЗнч(Параметры) = Тип("Соответствие") И Параметры.Получить("protocolVersion") <> Неопределено Тогда
		ВерсияПротокола = Строка(Параметры.Получить("protocolVersion"));
	КонецЕсли;

	Возможности = Новый Структура;
	Возможности.Вставить("tools", Новый Структура);

	ИнформацияОСервере = Новый Структура;
	ИнформацияОСервере.Вставить("name", "MCP:RSV Data");
	ИнформацияОСервере.Вставить("version", "0.1.0");

	Результат = Новый Структура;
	Результат.Вставить("protocolVersion", ВерсияПротокола);
	Результат.Вставить("capabilities", Возможности);
	Результат.Вставить("serverInfo", ИнформацияОСервере);
	Возврат Результат;
КонецФункции

Функция СписокИнструментов()
	Инструменты = Новый Массив;

	Инструменты.Добавить(ОписаниеИнструмента("ping",
		"Проверка связи с сервером MCP:RSV Data.",
		СхемаБезПараметров()));

	Инструменты.Добавить(ОписаниеИнструмента("config",
		"Паспорт базы: какая это конфигурация (имя, версия, поставщик, режим совместимости), подключённые расширения и бизнес-разделы (подсистемы) верхнего уровня. Полезно вызвать первым — понять, с какой базой работаешь.",
		СхемаБезПараметров()));

	Инструменты.Добавить(ОписаниеИнструмента("describe",
		"Поиск и обзор состава конфигурации, когда точные имена ещё не известны: категории объектов, поиск объекта по подстроке (filter или глобально find), объекты бизнес-раздела (subsystem), таблицы объекта, поля таблицы. Полную структуру одного объекта сразу даёт get_structure.",
		СхемаОписания()));

	Инструменты.Добавить(ОписаниеИнструмента("get_structure",
		"Полная структура ОДНОГО объекта по известному имени за один вызов: все таблицы (основная, табличные части, виртуальные таблицы регистров), поля с типами, значения перечислений, владельцы — основа для проектирования запроса. Найти имя объекта или осмотреть базу — describe.",
		СхемаСтруктуры()));

	Инструменты.Добавить(ОписаниеИнструмента("query",
		"Чтение данных ОДНОЙ таблицы по описанию (поля, отборы, сортировка, период), без языка запросов. Группировки и соединения не поддерживаются — для них execute_query.",
		СхемаЗапроса()));

	Инструменты.Добавить(ОписаниеИнструмента("execute_query",
		"Выполнение готового запроса на языке запросов 1С — мощный путь: группировки и итоги, соединения, разыменование через точку, вложенные запросы. Когда декларативного query мало.",
		СхемаПроизвольногоЗапроса()));

	Инструменты.Добавить(ОписаниеИнструмента("eventlog",
		"Журнал регистрации 1С: чтение записей с отборами (период, уровни, события, приложения, пользователи, сеансы) и получение допустимых значений отборов (values=true). Для событий отбор — ТОЧНОЕ системное имя (_$PerformError$_); их список берётся через values, подстрока filter сужает на сервере. Подстрока в комментарии — commentContains (поле comment — точное равенство).",
		СхемаЖурнала()));

	Инструменты.Добавить(ОписаниеИнструмента("reveal",
		"Расшифровка анонимизации: заменяет в тексте токены вида [ОРГ-00001] реальными значениями. Вызови на финальном ответе пользователю — модель работает с обезличенными данными, а человек видит реальные ФИО/контрагентов.",
		СхемаРасшифровки()));

	Инструменты.Добавить(ОписаниеИнструмента("help",
		"Справка по MCP:RSV Data: без параметров — обзор и список инструментов; topic=<имя инструмента> — подробное руководство с примерами; topic=workflow — типовые сценарии.",
		СхемаСправки()));

	Возврат Инструменты;
КонецФункции

Функция ВызватьИнструмент(Идентификатор, Параметры)
	ИмяИнструмента = "";
	Аргументы = Неопределено;
	Если ТипЗнч(Параметры) = Тип("Соответствие") Тогда
		ИмяИнструмента = Строка(Параметры.Получить("name"));
		Аргументы = Параметры.Получить("arguments");
	КонецЕсли;

	Если ИмяИнструмента = "ping" Тогда
		Возврат ОтветРезультат(Идентификатор, ВыполнитьPing());
	ИначеЕсли ИмяИнструмента = "config" Тогда
		Возврат ОтветРезультат(Идентификатор, ВыполнитьКонфиг());
	ИначеЕсли ИмяИнструмента = "describe" Тогда
		Возврат ОтветРезультат(Идентификатор, ВыполнитьОписание(Аргументы));
	ИначеЕсли ИмяИнструмента = "get_structure" Тогда
		Возврат ОтветРезультат(Идентификатор, ВыполнитьСтруктуру(Аргументы));
	ИначеЕсли ИмяИнструмента = "query" Тогда
		Возврат ОтветРезультат(Идентификатор, ВыполнитьЗапрос(Аргументы));
	ИначеЕсли ИмяИнструмента = "execute_query" Тогда
		Возврат ОтветРезультат(Идентификатор, ВыполнитьПроизвольныйЗапрос(Аргументы));
	ИначеЕсли ИмяИнструмента = "eventlog" Тогда
		Возврат ОтветРезультат(Идентификатор, ВыполнитьЖурнал(Аргументы));
	ИначеЕсли ИмяИнструмента = "reveal" Тогда
		Возврат ОтветРезультат(Идентификатор, ВыполнитьРасшифровку(Аргументы));
	ИначеЕсли ИмяИнструмента = "help" Тогда
		Возврат ОтветРезультат(Идентификатор, ВыполнитьСправку(Аргументы));
	Иначе
		Возврат ОтветРезультат(Идентификатор, РезультатТекст("Неизвестный инструмент: " + ИмяИнструмента, Истина));
	КонецЕсли;
КонецФункции

Функция ВыполнитьPing()
	Возврат РезультатТекст("pong — MCP:RSV Data на связи (" + Строка(ТекущаяДатаСеанса()) + ")", Ложь);
КонецФункции

Функция ВыполнитьОписание(Аргументы)
	Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		Аргументы = Новый Соответствие;
	КонецЕсли;
	ИмяТаблицы = Аргументы.Получить("table");
	ИмяОбъекта = Аргументы.Получить("object");
	КатегорияТипа = Аргументы.Получить("type");
	Поиск = Аргументы.Получить("find");
	Подсистема = Аргументы.Получить("subsystem");
	Фильтр = Аргументы.Получить("filter");

	Попытка
		Если ЗначениеЗаполнено(Поиск) Тогда
			Данные = RSVData_Ядро.ГлобальныйПоиск(Поиск);
		ИначеЕсли ЗначениеЗаполнено(Подсистема) Тогда
			Данные = RSVData_Ядро.ПодсистемаДетально(Подсистема);
		ИначеЕсли ЗначениеЗаполнено(ИмяТаблицы) Тогда
			Данные = RSVData_Ядро.СтруктураПолей(ИмяТаблицы);
		ИначеЕсли ЗначениеЗаполнено(ИмяОбъекта) Тогда
			Данные = RSVData_Ядро.ДоступныеТаблицы(ИмяОбъекта);
		ИначеЕсли ЗначениеЗаполнено(КатегорияТипа) Тогда
			Данные = RSVData_Ядро.ДоступныеОбъекты(КатегорияТипа, Фильтр);
		ИначеЕсли ЗначениеЗаполнено(Фильтр) Тогда
			// filter без type — трактуем как глобальный поиск (частая ошибка: забыли type).
			Данные = RSVData_Ядро.ГлобальныйПоиск(Фильтр);
		Иначе
			Данные = RSVData_Ядро.ДоступныеТипы();
		КонецЕсли;
	Исключение
		Возврат РезультатТекст(ОписаниеОшибки(), Истина);
	КонецПопытки;

	Возврат РезультатТекст(ВJSON(Данные), Ложь);
КонецФункции

Функция ОписаниеИнструмента(Имя, Описание, Схема)
	// Авто-простановка перекрёстной ссылки: если в справке есть тема с именем инструмента,
	// дописываем единый хвост «help topic=<имя>» — чтобы не забывать его при регистрации.
	ПолноеОписание = Описание;
	Если RSVData_Справка.ЕстьТема(Имя) Тогда
		ПолноеОписание = Описание + " Подробности и примеры: help topic=" + Имя + ".";
	КонецЕсли;
	Инструмент = Новый Структура;
	Инструмент.Вставить("name", Имя);
	Инструмент.Вставить("description", ПолноеОписание);
	Инструмент.Вставить("inputSchema", Схема);
	Возврат Инструмент;
КонецФункции

Функция СхемаБезПараметров()
	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Новый Структура);
	Возврат Схема;
КонецФункции

Функция СхемаОписания()
	Свойства = Новый Структура;
	Свойства.Вставить("type", СвойствоСхемы("string",
		"Категория объектов (Справочник, Документ, РегистрСведений, РегистрНакопления, ...). Без других параметров вернёт объекты этой категории."));
	Свойства.Вставить("filter", СвойствоСхемы("string",
		"Только с type: подстрока в имени или синониме (без учёта регистра) — сузить список одной категории."));
	Свойства.Вставить("find", СвойствоСхемы("string",
		"Глобальный поиск: подстрока в имени/синониме сразу по ВСЕМ категориям (без type). Вернёт объекты с их типами."));
	Свойства.Вставить("subsystem", СвойствоСхемы("string",
		"Имя бизнес-раздела (подсистемы): Продажи или путь Продажи.ОптовыеПродажи. Вернёт объекты раздела и вложенные подсистемы. Список разделов — в config."));
	Свойства.Вставить("object", СвойствоСхемы("string",
		"Полное имя объекта (Справочник.Номенклатура). Вернёт его таблицы. Полную структуру сразу — get_structure."));
	Свойства.Вставить("table", СвойствоСхемы("string",
		"Полное имя таблицы (Справочник.Номенклатура или Документ.РеализацияТоваровУслуг.Товары). Вернёт поля с типами."));

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Возврат Схема;
КонецФункции

Функция СвойствоСхемы(ТипJSON, Описание)
	Свойство = Новый Структура;
	Свойство.Вставить("type", ТипJSON);
	Свойство.Вставить("description", Описание);
	Возврат Свойство;
КонецФункции

Функция РезультатТекст(Текст, ЭтоОшибка)
	Элемент = Новый Структура;
	Элемент.Вставить("type", "text");
	Элемент.Вставить("text", Текст);

	Содержимое = Новый Массив;
	Содержимое.Добавить(Элемент);

	Результат = Новый Структура;
	Результат.Вставить("content", Содержимое);
	Результат.Вставить("isError", ЭтоОшибка);
	Возврат Результат;
КонецФункции

Функция ОтветРезультат(Идентификатор, Результат)
	Ответ = Новый Структура;
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", Идентификатор);
	Ответ.Вставить("result", Результат);
	Возврат Ответ;
КонецФункции

Функция ОтветОшибка(Идентификатор, Код, Сообщение)
	Ошибка = Новый Структура;
	Ошибка.Вставить("code", Код);
	Ошибка.Вставить("message", Сообщение);

	Ответ = Новый Структура;
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", Идентификатор);
	Ответ.Вставить("error", Ошибка);
	Возврат Ответ;
КонецФункции

Функция ПрочитатьJSONОбъект(Текст)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Функция ВJSON(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

Функция ВыполнитьЗапрос(Аргументы)
	Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		Аргументы = Новый Соответствие;
	КонецЕсли;
	Попытка
		Данные = RSVData_Ядро.ВыполнитьЧтение(Аргументы);
	Исключение
		Возврат РезультатТекст(ОписаниеОшибки(), Истина);
	КонецПопытки;
	Возврат РезультатТекст(ВJSON(Данные), Ложь);
КонецФункции

Функция СхемаЗапроса()
	Свойства = Новый Структура;
	Свойства.Вставить("table", СвойствоСхемы("string",
		"Полное имя таблицы: основной (Справочник.Номенклатура), табличной части (Документ.РеализацияТоваровУслуг.Товары) или виртуальной таблицы регистра (РегистрНакопления.ТоварыНаСкладах.Остатки). Обязательный."));

	ПолеСписокПолей = Новый Структура;
	ПолеСписокПолей.Вставить("type", "array");
	ПолеСписокПолей.Вставить("items", Новый Структура("type", "string"));
	ПолеСписокПолей.Вставить("description",
		"Какие поля вернуть. Если не указано — все поля таблицы. Точные имена полей даёт get_structure (или describe table=...).");
	Свойства.Вставить("fields", ПолеСписокПолей);

	СвойстваОтбора = Новый Структура;
	СвойстваОтбора.Вставить("field", СвойствоСхемы("string", "Имя поля."));
	СвойстваОтбора.Вставить("comparison", СвойствоСхемы("string",
		"Вид сравнения: equal, notEqual, greater, greaterOrEqual, less, lessOrEqual, contains, notContains, inList, notInList, filled, notFilled. По умолчанию equal. contains/notContains — поиск подстроки без учёта регистра."));
	СвойстваОтбора.Вставить("value", Новый Структура("description", "Значение сравнения; для inList/notInList — массив значений."));
	ЭлементОтбора = Новый Структура;
	ЭлементОтбора.Вставить("type", "object");
	ЭлементОтбора.Вставить("properties", СвойстваОтбора);
	ПолеОтборы = Новый Структура;
	ПолеОтборы.Вставить("type", "array");
	ПолеОтборы.Вставить("items", ЭлементОтбора);
	ПолеОтборы.Вставить("description", "Отборы данных (соединяются по И).");
	Свойства.Вставить("filters", ПолеОтборы);

	ПолеПорядок = Новый Структура;
	ПолеПорядок.Вставить("type", "array");
	ПолеПорядок.Вставить("items", Новый Структура("type", "string"));
	ПолеПорядок.Вставить("description", "Сортировка: ""Поле"" — по возрастанию, ""-Поле"" — по убыванию.");
	Свойства.Вставить("order", ПолеПорядок);

	Свойства.Вставить("period", СвойствоСхемы("string",
		"Момент для виртуальных таблиц регистров (Остатки/СрезПоследних/СрезПервых) в формате ГГГГ-ММ-ДД. Без него — текущие остатки."));
	Свойства.Вставить("limit", СвойствоСхемы("integer", "Максимум строк (по умолчанию 100, максимум 1000)."));
	Свойства.Вставить("offset", СвойствоСхемы("integer", "Сколько строк пропустить (постранично). По умолчанию 0."));

	Обязательные = Новый Массив;
	Обязательные.Добавить("table");

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", Обязательные);
	Возврат Схема;
КонецФункции

Функция ВыполнитьСправку(Аргументы)
	Тема = "";
	Если ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
		ЗначениеТемы = Аргументы.Получить("topic");
		Если ЗначениеТемы <> Неопределено Тогда
			Тема = Строка(ЗначениеТемы);
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(Тема) Тогда
		Возврат РезультатТекст(RSVData_Справка.ПоТеме(Тема), Ложь);
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить(RSVData_Справка.Вступление());
	Строки.Добавить("");
	Строки.Добавить("Инструменты:");
	Для Каждого Инструмент Из СписокИнструментов() Цикл
		Строки.Добавить("- " + Инструмент.name + ": " + Инструмент.description);
	КонецЦикла;
	Строки.Добавить("");
	Строки.Добавить("Подробнее по инструменту: help topic=<имя>. Типовые сценарии: help topic=workflow.");
	Строки.Добавить("");
	Строки.Добавить(RSVData_Справка.ПродуктоваяСноска());
	Возврат РезультатТекст(СтрСоединить(Строки, Символы.ПС), Ложь);
КонецФункции

Функция СхемаСправки()
	Свойства = Новый Структура;
	Свойства.Вставить("topic", СвойствоСхемы("string",
		"Тема справки: имя инструмента (query, describe) или обзорная тема (workflow, about). Без параметра — общий обзор и список инструментов."));

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Возврат Схема;
КонецФункции

Функция ВыполнитьПроизвольныйЗапрос(Аргументы)
	Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		Аргументы = Новый Соответствие;
	КонецЕсли;
	Попытка
		Данные = RSVData_Ядро.ВыполнитьПроизвольныйЗапрос(
			Аргументы.Получить("query"),
			Аргументы.Получить("parameters"),
			Аргументы.Получить("limit"));
	Исключение
		Возврат РезультатТекст(ОписаниеОшибки(), Истина);
	КонецПопытки;
	Возврат РезультатТекст(ВJSON(Данные), Ложь);
КонецФункции

Функция СхемаПроизвольногоЗапроса()
	Свойства = Новый Структура;
	Свойства.Вставить("query", СвойствоСхемы("string",
		"Текст запроса на языке запросов 1С (только чтение). Пример: ВЫБРАТЬ ПЕРВЫЕ 10 Наименование ИЗ Справочник.Номенклатура. Обязательный."));

	ПолеПараметры = Новый Структура;
	ПолеПараметры.Вставить("type", "object");
	ПолеПараметры.Вставить("description",
		"Параметры запроса: имя -> значение (для &Имя в тексте). Даты — строкой ГГГГ-ММ-ДД. Для списков (В (...)) — массив значений.");
	Свойства.Вставить("parameters", ПолеПараметры);

	Свойства.Вставить("limit", СвойствоСхемы("integer", "Максимум строк (по умолчанию 100, максимум 1000)."));

	Обязательные = Новый Массив;
	Обязательные.Добавить("query");

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", Обязательные);
	Возврат Схема;
КонецФункции

Функция ВыполнитьСтруктуру(Аргументы)
	Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		Аргументы = Новый Соответствие;
	КонецЕсли;
	Попытка
		Данные = RSVData_Ядро.СтруктураОбъекта(Аргументы.Получить("object"));
	Исключение
		Возврат РезультатТекст(ОписаниеОшибки(), Истина);
	КонецПопытки;
	Возврат РезультатТекст(ВJSON(Данные), Ложь);
КонецФункции

