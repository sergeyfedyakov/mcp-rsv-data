#Область ПрограммныйИнтерфейс

// Возвращает обзорный текст: назначение продукта и рабочий процесс.
// Список инструментов формирует вызывающий код из реестра — здесь только прозаическая обвязка.
//
// Возвращаемое значение:
//   Строка - текст вступления для обзорной справки.
Функция Вступление() Экспорт
	Текст = Новый Массив;
	Текст.Добавить("MCP:RSV Data — доступ к ДАННЫМ рабочей базы 1С (runtime): чтение объектов, запросы, остатки.");
	Текст.Добавить("Рабочий процесс: сначала describe (узнать состав и точные имена), затем query (получить данные).");
	Текст.Добавить("Язык запросов 1С знать не нужно — запрос строит платформа по твоему описанию.");
	Возврат СтрСоединить(Текст, Символы.ПС);
КонецФункции

Функция ПоТеме(Тема) Экспорт
	Ключ = НРег(СокрЛП(Строка(Тема)));
	Если Ключ = "query" Тогда
		Возврат СправкаQuery();
	ИначеЕсли Ключ = "execute_query" Тогда
		Возврат СправкаExecuteQuery();
	ИначеЕсли Ключ = "config" Тогда
		Возврат СправкаConfig();
	ИначеЕсли Ключ = "describe" Тогда
		Возврат СправкаDescribe();
	ИначеЕсли Ключ = "get_structure" Тогда
		Возврат СправкаGetStructure();
	ИначеЕсли Ключ = "eventlog" Тогда
		Возврат СправкаEventLog();
	ИначеЕсли Ключ = "reveal" Тогда
		Возврат СправкаReveal();
	ИначеЕсли Ключ = "anonymization" ИЛИ Ключ = "анонимизация" Тогда
		Возврат СправкаAnonymization();
	ИначеЕсли Ключ = "workflow" Тогда
		Возврат СправкаWorkflow();
	ИначеЕсли Ключ = "about" Тогда
		Возврат СправкаAbout();
	Иначе
		Возврат СтрШаблон("Нет справки по теме ""%1"". Доступные темы: config, describe, get_structure, query, execute_query, eventlog, reveal, anonymization, workflow, about.", Тема);
	КонецЕсли;
КонецФункции

// Возвращает ненавязчивую сноску-воронку к платному продукту (для тем about и обзора).
//
// Возвращаемое значение:
//   Строка - текст сноски с указанием на платный продукт MCP:RSV Server.
Функция ПродуктоваяСноска() Экспорт
	Возврат "Нужна не работа с данными, а РАЗРАБОТКА в 1С:EDT (код, метаданные, формы, отладка)?"
		+ " Это другой продукт — MCP:RSV Server: prepod2003.github.io/edt-ai-1c";
КонецФункции

// Возвращает сведения о разработчике продукта и сайт автора.
//
// Возвращаемое значение:
//   Строка - строка «Разработчик … Сайт …» для темы about.
Функция ИнформацияОРазработчике() Экспорт
	Возврат "Разработчик: Радзивиллович Сергей. Сайт: https://prepod2003.github.io/edt-ai-1c/";
КонецФункции

Функция ЕстьТема(Тема) Экспорт
	Ключ = НРег(СокрЛП(Строка(Тема)));
	Возврат Ключ = "config" ИЛИ Ключ = "describe" ИЛИ Ключ = "get_structure" ИЛИ Ключ = "query"
		ИЛИ Ключ = "execute_query" ИЛИ Ключ = "eventlog" ИЛИ Ключ = "reveal" ИЛИ Ключ = "workflow" ИЛИ Ключ = "about";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СправкаQuery()
	Т = Новый Массив;
	Т.Добавить("query — чтение данных ОДНОЙ таблицы по декларативному описанию (язык запросов знать не нужно).");
	Т.Добавить("Группировок, итогов и соединений нет — для них execute_query.");
	Т.Добавить("");
	Т.Добавить("Параметры:");
	Т.Добавить("- table (обязательный) — что читаем:");
	Т.Добавить("    справочник: Справочник.Номенклатура");
	Т.Добавить("    документ: Документ.РеализацияТоваровУслуг");
	Т.Добавить("    табличная часть: Документ.РеализацияТоваровУслуг.Товары");
	Т.Добавить("    виртуальная таблица регистра: РегистрНакопления.ТоварыНаСкладах.Остатки");
	Т.Добавить("- fields — массив имён полей. Пусто = все поля таблицы. Точные имена даёт get_structure.");
	Т.Добавить("- filters — массив отборов {field, comparison, value}. comparison: equal, notEqual, greater,");
	Т.Добавить("  greaterOrEqual, less, lessOrEqual, contains, notContains, inList, notInList, filled, notFilled.");
	Т.Добавить("  contains/notContains — поиск подстроки БЕЗ учёта регистра. Для inList/notInList value — массив.");
	Т.Добавить("- order — массив сортировки: ""Поле"" по возрастанию, ""-Поле"" по убыванию.");
	Т.Добавить("- period — дата для виртуальных таблиц (Остатки/СрезПоследних/СрезПервых), формат ГГГГ-ММ-ДД.");
	Т.Добавить("- limit — максимум строк (по умолчанию 100, максимум 1000); offset — пропустить строк (постранично).");
	Т.Добавить("");
	Т.Добавить("Подсказки:");
	Т.Добавить("- У иерархических справочников добавляй отбор {field:ЭтоГруппа, comparison:equal, value:false}, чтобы не получать папки.");
	Т.Добавить("- Имена и значения полей (в т.ч. виртуальных таблиц и перечислений) — из get_structure.");
	Т.Добавить("- Если в данных стоит токен [ОРГ-00001] — это обезличенные ПДн; его же можно вернуть в filters value (drill-down). См. help topic=anonymization.");
	Т.Добавить("");
	Т.Добавить("Примеры аргументов:");
	Т.Добавить("- 10 номенклатур со словом молоко: {""table"":""Справочник.Номенклатура"",""fields"":[""Наименование"",""Артикул""],""filters"":[{""field"":""Наименование"",""comparison"":""contains"",""value"":""молоко""}],""limit"":10}");
	Т.Добавить("- остатки на складах на дату: {""table"":""РегистрНакопления.ТоварыНаСкладах.Остатки"",""period"":""2026-01-01""}");
	Т.Добавить("- строки товаров документов: {""table"":""Документ.РеализацияТоваровУслуг.Товары"",""limit"":50}");
	Т.Добавить("- документы по убыванию даты: {""table"":""Документ.РеализацияТоваровУслуг"",""order"":[""-Дата""],""limit"":20}");
	Т.Добавить("");
	Т.Добавить("Ответ: Таблица, Колонки (Имя+Тип), Строки (поле в значение; ссылки представлением; ПДн — токенами),");
	Т.Добавить("КоличествоСтрок, Лимит, ЕстьЕщё. Неверное поле — понятная ошибка с подсказкой про describe.");
	Возврат СтрСоединить(Т, Символы.ПС);
КонецФункции

Функция СправкаDescribe()
	Т = Новый Массив;
	Т.Добавить("describe — поиск и обзор состава конфигурации (что есть в базе и как называется),");
	Т.Добавить("когда точные имена объектов ещё не известны.");
	Т.Добавить("");
	Т.Добавить("Режимы (по параметрам):");
	Т.Добавить("- без параметров — категории объектов с количеством (Справочник, Документ, РегистрНакопления, ...).");
	Т.Добавить("- find=<подстрока> — глобальный поиск по ВСЕМ категориям сразу (вернёт объекты с их типами).");
	Т.Добавить("- subsystem=<имя> — объекты бизнес-раздела (Продажи) и вложенные подсистемы. Список разделов — в config.");
	Т.Добавить("- type=Справочник — объекты этой категории (имя, полное имя, синоним).");
	Т.Добавить("    filter=<подстрока> — сузить список ОДНОЙ категории (по имени и синониму, без учёта регистра).");
	Т.Добавить("- object=Справочник.Номенклатура — таблицы объекта (основная, табличные части, виртуальные таблицы).");
	Т.Добавить("- table=Справочник.Номенклатура — поля таблицы с типами и видами (Реквизит/Измерение/Ресурс/...).");
	Т.Добавить("");
	Т.Добавить("Что за база в целом (конфигурация, версия, расширения, разделы) — инструмент config.");
	Т.Добавить("Когда имя объекта уже известно и нужна ВСЯ его структура сразу — это get_structure, а не describe.");
	Т.Добавить("Отдаёт только доступное текущему пользователю на чтение. Работает на любой конфигурации.");
	Т.Добавить("Типовой порядок: config (что за база) → describe (найти имя) → get_structure (структура) → query.");
	Возврат СтрСоединить(Т, Символы.ПС);
КонецФункции

Функция СправкаWorkflow()
	Т = Новый Массив;
	Т.Добавить("Типовые сценарии (хочу X — делай так):");
	Т.Добавить("");
	Т.Добавить("0) Понять, что за база:");
	Т.Добавить("   config → конфигурация, версия, расширения, бизнес-разделы (подсистемы).");
	Т.Добавить("1) Найти объект и его структуру:");
	Т.Добавить("   describe find=<часть имени> (по всей базе) ИЛИ describe type=Справочник filter=<часть> → get_structure object=...");
	Т.Добавить("2) Объекты бизнес-раздела:");
	Т.Добавить("   describe subsystem=Продажи → объекты раздела и вложенные подсистемы.");
	Т.Добавить("3) Список элементов справочника с отбором:");
	Т.Добавить("   query table=Справочник.Номенклатура, filters=[{field:Наименование, comparison:contains, value:...}].");
	Т.Добавить("4) Остатки регистра на дату:");
	Т.Добавить("   query table=РегистрНакопления.X.Остатки, period=ГГГГ-ММ-ДД (имена ресурсов — из get_structure).");
	Т.Добавить("5) Строки табличной части документов:");
	Т.Добавить("   query table=Документ.X.ИмяТабличнойЧасти.");
	Т.Добавить("6) Последние документы:");
	Т.Добавить("   query table=Документ.X, order=[""-Дата""], limit=...");
	Т.Добавить("7) Сложная выборка (соединения, группировки, итоги, объединения):");
	Т.Добавить("   execute_query query=<текст запроса на языке запросов 1С> — см. help topic=execute_query.");
	Т.Добавить("8) Сводка по значениям поля (в т.ч. перечисления):");
	Т.Добавить("   get_structure (увидеть поле и его значения) → execute_query со СГРУППИРОВАТЬ ПО этому полю и КОЛИЧЕСТВО().");
	Т.Добавить("9) Топ-N по сумме:");
	Т.Добавить("   execute_query: ВЫБРАТЬ ПЕРВЫЕ N ..., СУММА(...) ... СГРУППИРОВАТЬ ПО ... УПОРЯДОЧИТЬ ПО ... УБЫВ.");
	Т.Добавить("10) Персональные данные обезличены токенами [ОРГ-00001]/[ФЛ-00001]:");
	Т.Добавить("    отбор/параметр по токену работает (drill-down), итоговый ответ пользователю — через reveal.");
	Т.Добавить("    Подробно — help topic=anonymization.");
	Т.Добавить("");
	Т.Добавить("Принцип: config (что за база) → describe (найти) → get_structure (точные имена) → query, а где его мало — execute_query.");
	Возврат СтрСоединить(Т, Символы.ПС);
КонецФункции

