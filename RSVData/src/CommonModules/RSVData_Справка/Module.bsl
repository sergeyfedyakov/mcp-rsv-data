	Т.Добавить("");
	Т.Добавить("Пример: {""object"":""Документ.РеализацияТоваровУслуг""}");
	Т.Добавить("");
	Т.Добавить("Когда имя объекта ещё не известно — сначала найдите его через describe (поиск по подстроке).");
	Т.Добавить("Отличие от describe: describe — поиск/обзор имён по шагам; get_structure — весь объект сразу.");
	Возврат СтрСоединить(Т, Символы.ПС);
КонецФункции

Функция СправкаReveal()
	Т = Новый Массив;
	Т.Добавить("reveal — расшифровка анонимизации: заменяет в тексте токены [КАТЕГОРИЯ-NNNNN] реальными значениями.");
	Т.Добавить("Зачем: персональные данные (ФИО, контрагенты, ИНН, телефоны, адреса) в ответах query/execute_query");
	Т.Добавить("по умолчанию заменены на стабильные токены — модель не видит их в открытом виде. Когда готовишь");
	Т.Добавить("ИТОГОВЫЙ ответ пользователю, передай его через reveal — человек увидит реальные значения.");
	Т.Добавить("");
	Т.Добавить("Параметр:");
	Т.Добавить("- text (обязательный) — текст с токенами (обычно финальный ответ пользователю).");
	Т.Добавить("");
	Т.Добавить("Пример: {""text"":""Крупнейший клиент — [ОРГ-00001], сумма 1 200 000 руб.""}");
	Т.Добавить("Ответ: тот же текст, где [ОРГ-00001] заменён реальным наименованием. Неизвестные токены остаются как есть.");
	Т.Добавить("");
	Т.Добавить("Про анонимизацию в целом — help topic=anonymization.");
	Возврат СтрСоединить(Т, Символы.ПС);
КонецФункции

Функция СправкаAnonymization()
	Т = Новый Массив;
	Т.Добавить("Анонимизация персональных данных — включена по умолчанию (стандарт защиты).");
