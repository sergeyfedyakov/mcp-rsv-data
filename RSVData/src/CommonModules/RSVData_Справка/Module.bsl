Функция СправкаExecuteQuery()
	Т = Новый Массив;
	Т.Добавить("execute_query — выполнение готового запроса на языке запросов 1С (мощный путь).");
	Т.Добавить("Поддерживает соединения, группировки (СГРУППИРОВАТЬ ПО), агрегаты (СУММА, КОЛИЧЕСТВО,");
	Т.Добавить("МАКСИМУМ, МИНИМУМ, СРЕДНЕЕ), сортировку (УПОРЯДОЧИТЬ ПО ... УБЫВ/ВОЗР), вложенные запросы.");
	Т.Добавить("Разыменование через точку: Товары.Номенклатура.Наименование (имя товара из строки документа).");
	Т.Добавить("Для простого чтения одной таблицы достаточно query.");
	Т.Добавить("");
	Т.Добавить("Параметры:");
	Т.Добавить("- query (обязательный) — текст запроса на языке запросов 1С. Только чтение данных");
	Т.Добавить("  (язык запросов не изменяет базу). Имена таблиц и полей даёт get_structure.");
	Т.Добавить("- parameters — значения параметров запроса (имя -> значение) для &Имя в тексте.");
	Т.Добавить("  Даты передавай строкой ГГГГ-ММ-ДД или ГГГГ-ММ-ДДTчч:мм:сс. Для списков (В (&П)) — массив.");
	Т.Добавить("  Токен анонимизации ([ОРГ-00001]) в параметре сервер сам заменит на реальное значение (drill-down).");
	Т.Добавить("  При включённой анонимизации выражения, преобразующие ПДн (ПОДСТРОКА/СЦЕПИТЬ над наименованием");
	Т.Добавить("  контрагента и т.п.), отклоняются — выбирай поле целиком (Ссылка, Наименование, ПРЕДСТАВЛЕНИЕ(Ссылка)),");
	Т.Добавить("  оно вернётся токеном. Подробнее: help topic=anonymization.");
	Т.Добавить("- limit — максимум строк (по умолчанию 100, максимум 1000).");
	Т.Добавить("");
	Т.Добавить("Примеры аргументов:");
	Т.Добавить("- топ-5: {""query"":""ВЫБРАТЬ ПЕРВЫЕ 5 Наименование, Код ИЗ Справочник.Номенклатура""}");
	Т.Добавить("- с параметром: {""query"":""ВЫБРАТЬ Наименование ИЗ Справочник.Номенклатура ГДЕ ПометкаУдаления = &Пометка"",""parameters"":{""Пометка"":false}}");
	Т.Добавить("- с датой: {""query"":""ВЫБРАТЬ ПЕРВЫЕ 20 Ссылка, Дата ИЗ Документ.РеализацияТоваровУслуг ГДЕ Дата >= &Начало"",""parameters"":{""Начало"":""2026-01-01""}}");
	Т.Добавить("- топ-5 товаров по сумме (группировка + агрегат + сортировка):");
	Т.Добавить("  {""query"":""ВЫБРАТЬ ПЕРВЫЕ 5 Товары.Номенклатура.Наименование КАК Товар, СУММА(Товары.Сумма) КАК Сумма ИЗ Документ.РеализацияТоваровУслуг.Товары КАК Товары СГРУППИРОВАТЬ ПО Товары.Номенклатура.Наименование УПОРЯДОЧИТЬ ПО Сумма УБЫВ""}");
	Т.Добавить("");
	Т.Добавить("Ответ: Колонки (Имя+Тип), Строки (ссылки представлением; ПДн — токенами), КоличествоСтрок, Лимит, ЕстьЕщё.");
	Т.Добавить("Пустой или синтаксически неверный запрос — понятная ошибка.");
	Т.Добавить("");
	Т.Добавить("query или execute_query? Простое чтение одной таблицы — query. Группировки/итоги/соединения — execute_query.");
	Возврат СтрСоединить(Т, Символы.ПС);
КонецФункции

Функция СправкаGetStructure()
	Т = Новый Массив;
	Т.Добавить("get_structure — полная структура ОДНОГО объекта по известному имени за один вызов.");
	Т.Добавить("Даёт всё для проектирования запроса на незнакомой конфигурации: точные имена таблиц");
	Т.Добавить("и полей, типы (полные имена ссылок), значения перечислений, табличные части, владельцев.");
	Т.Добавить("");
	Т.Добавить("Параметр:");
	Т.Добавить("- object (обязательный) — полное имя объекта (Тип.Имя), например:");
	Т.Добавить("    Справочник.Контрагенты, Документ.РеализацияТоваровУслуг, РегистрНакопления.ТоварыНаСкладах.");
	Т.Добавить("");
	Т.Добавить("Ответ (JSON): Объект, Синоним, Категория, Таблицы[] (Имя=готовый FQN для запроса, Вид,");
	Т.Добавить("Представление, Поля[]), Владельцы[] (для подчинённых справочников). Поле: Имя, Тип, Вид");
	Т.Добавить("(Реквизит/Измерение/Ресурс/СтандартныйРеквизит), Синоним, Значения (для перечислений — имя+синоним).");
	Т.Добавить("Поля виртуальных таблиц регистров готовы к запросу: у Остатков ресурс называется <Ресурс>Остаток");
