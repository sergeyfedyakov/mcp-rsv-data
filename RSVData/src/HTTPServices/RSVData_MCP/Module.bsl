
// Обработчик POST /hs/rsvdata/mcp — точка входа MCP по HTTP.
// Тело читаем бинарно и декодируем как UTF-8 явно (надёжно для кириллицы в аргументах),
// затем передаём в транспорт-независимый RSVData_Сервер.
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - входящий POST-запрос с телом JSON-RPC.
//
// Возвращаемое значение:
//   HTTPСервисОтвет - 200 с телом JSON-ответа; 202 без тела, если ответ не требуется (уведомление).
Функция ОбработатьСообщение(Запрос)
	ДвоичныеДанные = Запрос.ПолучитьТелоКакДвоичныеДанные();
	Если ДвоичныеДанные = Неопределено Тогда
		ТелоЗапроса = "";
	Иначе
		ТелоЗапроса = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, "UTF-8");
	КонецЕсли;

	ТекстОтвета = RSVData_Сервер.ОбработатьСообщение(ТелоЗапроса);

	Если ПустаяСтрока(ТекстОтвета) Тогда
		// Уведомление — ответ не требуется.
		Возврат Новый HTTPСервисОтвет(202);
	КонецЕсли;

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТекстОтвета, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции
