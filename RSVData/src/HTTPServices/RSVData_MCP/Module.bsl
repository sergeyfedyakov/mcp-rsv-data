
// Обработчик POST /hs/rsvdata/mcp — точка входа MCP по HTTP.
// Тело читаем бинарно и декодируем как UTF-8 явно (надёжно для кириллицы в аргументах),
// затем передаём в транспорт-независимый RSVData_Сервер.
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - входящий POST-запрос с телом JSON-RPC.
//
// Возвращаемое значение:
//   HTTPСервисОтвет - 200 с телом JSON-ответа; 202 без тела, если ответ не требуется (уведомление).
Функция ОбработатьСообщение(Запрос)
	ДвоичныеДанные = Запрос.ПолучитьТелоКакДвоичныеДанные();
	Если ДвоичныеДанные = Неопределено Тогда
		ТелоЗапроса = "";
	Иначе
		ТелоЗапроса = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, "UTF-8");
	КонецЕсли;

	ТекстОтвета = RSVData_Сервер.ОбработатьСообщение(ТелоЗапроса);

	Если ПустаяСтрока(ТекстОтвета) Тогда
		// Уведомление — ответ не требуется.
		Возврат Новый HTTPСервисОтвет(202);
	КонецЕсли;

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТекстОтвета, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

// Обработчик POST /hs/rsvdata/update — служебная точка (само)обновления расширения.
// Тело запроса — .cfe (двоичные данные); в ответе JSON-отчёт о выполнении.
// В протокол MCP не входит: вызывается напрямую, например роутером rsv-data-router.
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - входящий POST-запрос с телом .cfe.
//
// Возвращаемое значение:
//   HTTPСервисОтвет - 200 с JSON-отчётом; 400 — пустое тело; 500 — ошибка выполнения.
Функция ОбработатьОбновление(Запрос)
	ДвоичныеДанные = Запрос.ПолучитьТелоКакДвоичныеДанные();
	Если ДвоичныеДанные = Неопределено Или ДвоичныеДанные.Размер() = 0 Тогда
		Ответ = Новый HTTPСервисОтвет(400);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки("{""результат"":""ошибка"",""описание"":""тело запроса пустое: ожидается файл .cfe""}",
			КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		Возврат Ответ;
	КонецЕсли;

	Попытка
		ТекстОтчёта = RSVData_Сервер.ОбновитьРасширение(ДвоичныеДанные);
	Исключение
		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки("update: " + ОписаниеОшибки(),
			КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		Возврат Ответ;
	КонецПопытки;

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТекстОтчёта, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

// Обработчик POST /hs/rsvdata/remove — служебная точка самоудаления расширения.
// Тело запроса игнорируется; в ответе JSON-отчёт о выполнении.
// В протокол MCP не входит: вызывается напрямую, например роутером rsv-data-router.
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - входящий POST-запрос.
//
// Возвращаемое значение:
//   HTTPСервисОтвет - 200 с JSON-отчётом; 500 — ошибка выполнения.
Функция ОбработатьУдаление(Запрос)
	Попытка
		ТекстОтчёта = RSVData_Сервер.УдалитьРасширение();
	Исключение
		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки("remove: " + ОписаниеОшибки(),
			КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		Возврат Ответ;
	КонецПопытки;

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТекстОтчёта, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции
