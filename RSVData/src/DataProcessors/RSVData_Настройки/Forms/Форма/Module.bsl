#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Состояние флажков — из констант; запись выполняют обработчики ПриИзменении.
	ВключитьНебезопасныеМетоды = Константы.RSVData_ВключитьНебезопасныеМетоды.Получить();
	АнонимизацияОтключена = Константы.RSVData_АнонимизацияОтключена.Получить();
	// Аудит/диагностика: фиксирует сам факт выполнения модуля формы.
	ЗаписьЖурналаРегистрации("RSVData.Настройки.ФормаОткрыта", УровеньЖурналаРегистрации.Информация,
		Метаданные.Обработки.RSVData_Настройки, , "Форма настроек открыта");
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВключитьНебезопасныеМетодыПриИзменении(Элемент)
	// Флажок применяется немедленно: константа пишется в момент переключения.
	ЗаписатьКонстантуНаСервере("RSVData_ВключитьНебезопасныеМетоды", ВключитьНебезопасныеМетоды);
КонецПроцедуры


&НаКлиенте
Процедура АнонимизацияОтключенаПриИзменении(Элемент)
	// Флажок применяется немедленно: константа пишется в момент переключения.
	ЗаписатьКонстантуНаСервере("RSVData_АнонимизацияОтключена", АнонимизацияОтключена);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьКонстантуНаСервере(ИмяКонстанты, Значение)
	// Запись константы (у КонстантаМенеджера нет Записать — пишется через Установить).
	// Аудит/диагностика: фиксирует факт переключения флажка.
	ЗаписьЖурналаРегистрации("RSVData.Настройки.ИзменениеФлажка", УровеньЖурналаРегистрации.Информация,
		Метаданные.Обработки.RSVData_Настройки, , "Флажок " + ИмяКонстанты + " = " + Значение);
	Попытка
		Константы[ИмяКонстанты].Установить(Значение);
	Исключение
		ЗаписьЖурналаРегистрации("RSVData.Настройки.ОшибкаЗаписи", УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Обработки.RSVData_Настройки, , ИмяКонстанты + ": " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

