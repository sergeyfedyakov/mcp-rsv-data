    </dataPath>
    <handlers>
      <event>OnChange</event>
      <name>АнонимизацияОтключенаПриИзменении</name>
    </handlers>
    <extendedTooltip>
      <name>АнонимизацияОтключенаРасширеннаяПодсказка</name>
      <id>9</id>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
