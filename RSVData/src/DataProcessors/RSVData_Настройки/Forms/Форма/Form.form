<?xml version="1.0" encoding="UTF-8"?>
<form:Form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:form="http://g5.1c.ru/v8/dt/form">
  <items xsi:type="form:FormField">
    <name>ВключитьНебезопасныеМетоды</name>
    <id>1</id>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <dataPath xsi:type="form:DataPath">
      <segments>ВключитьНебезопасныеМетоды</segments>
    </dataPath>
    <handlers>
      <event>OnChange</event>
      <name>ВключитьНебезопасныеМетодыПриИзменении</name>
    </handlers>
    <extendedTooltip>
      <name>ВключитьНебезопасныеМетодыРасширеннаяПодсказка</name>
      <id>3</id>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <extInfo xsi:type="form:LabelDecorationExtInfo">
        <horizontalAlign>Left</horizontalAlign>
      </extInfo>
    </extendedTooltip>
    <contextMenu>
      <name>ВключитьНебезопасныеМетодыКонтекстноеМеню</name>
